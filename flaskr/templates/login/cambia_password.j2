{% extends 'base.j2' %}
{% block title %}Cambia password · Ordini Panettoni{% endblock %}
{% block content %}
<div class="container-fluid py-3" style="max-width:620px">
  <div class="card p-3">
    <h1 class="h5 mb-3">Cambia password personale</h1>
    <form action="{{ url_for('auth.cambia_password_personale') }}" method="post">
      <input type="hidden" name="csrf_token" value="{{ csrf_ruoli() }}">
      <div class="mb-3">
        <label class="form-label" for="pw-old">Password attuale</label>
        <input class="form-control" id="pw-old" type="password" name="password_attuale" autocomplete="current-password" required>
      </div>
      <div class="mb-3">
        <label class="form-label" for="pw-new">Nuova password</label>
        <input class="form-control" id="pw-new" type="password" name="password_nuova" autocomplete="new-password" required>
      </div>
      <div class="mb-3">
        <label class="form-label" for="pw-repeat">Conferma nuova password</label>
        <input class="form-control" id="pw-repeat" type="password" name="password_conferma" autocomplete="new-password" required>
      </div>
      <button class="btn btn-primary" type="submit">Salva nuova password</button>
    </form>
  </div>
</div>
{% endblock %}
