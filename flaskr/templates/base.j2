<!doctype html>
<html lang="it">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Ordini Panettoni{% endblock %}</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='vendor/bootstrap-5.0.2-dist/css/bootstrap.min.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/style.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', filename='vendor/fullcalendar-7.1.0/dist/skeleton.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', filename='vendor/fullcalendar-7.1.0/dist/themes/forma/theme.css') }}">
    {# Tema ricavato dal gestionale Vendite, isolato sul nuovo applicativo. #}
    <link rel="stylesheet" href="{{ url_for('static', filename='css/tema_panettoni.css', v='20261021-2') }}">
    {% block head %}{% endblock %}
</head>
<body class="pan-app-body">
{% set pan_logged_in = g is defined and g.user is defined and g.user is not none %}
{% set pan_role = ruolo_corrente|default('', true) %}
{% set pan_can_produce = puo_gestire_produzione|default(false) or pan_role in ('admin', 'utente_produzione') %}
{% if pan_logged_in %}
<header class="pan-app-header" role="banner">
    <div class="pan-app-header-inner">
        <div class="pan-header-menu">
            <button class="btn btn-light pan-menu-button" type="button" data-bs-toggle="offcanvas" data-bs-target="#pan-navigation" aria-controls="pan-navigation" aria-label="Apri menu di navigazione">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
            </button>
        </div>
        <div class="pan-header-identity">
            <span class="pan-header-role">
            {% if pan_role == 'admin' %}Amministrazione{% elif pan_role == 'utente_produzione' %}Produzione{% elif pan_role == 'utente_vendite' %}Vendite{% else %}Gestione ordini{% endif %}
            </span>
            <span class="pan-header-separator" aria-hidden="true">·</span>
            <strong class="pan-header-user">{{ g.user.username }}</strong>
        </div>
        <div class="pan-header-brand" aria-label="Ordini Panettoni">
            <span class="pan-brand-symbol" aria-hidden="true">OP</span>
            <span class="pan-brand-text">Ordini <strong>Panettoni</strong></span>
        </div>
    </div>
</header>
<nav class="offcanvas offcanvas-start pan-offcanvas" id="pan-navigation" tabindex="-1" aria-labelledby="pan-navigation-title">
    <div class="offcanvas-header border-bottom">
        <h2 class="offcanvas-title h5 mb-0" id="pan-navigation-title">Navigazione</h2>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Chiudi"></button>
    </div>
    <div class="offcanvas-body">
        <div class="pan-nav-caption">Consultazione</div>
        <a class="pan-nav-item" href="{{ url_for('ordini_cliente.ordini_cliente') }}">Gestione ordini</a>
        <a class="pan-nav-item" href="{{ url_for('ordini_cliente.ordini_calendario') }}">Calendario produzione</a>
        {% if pan_can_produce %}
        <div class="pan-nav-caption mt-3">Produzione</div>
        <a class="pan-nav-item" href="{{ url_for('ordini_cliente.calendario_macchine') }}">Impiego impastatrici</a>
        <a class="pan-nav-item" href="{{ url_for('ordini_cliente.stock_articoli') }}">Stock panettoni</a>
        <a class="pan-nav-item" href="{{ url_for('ordini_cliente.pianificazioni_chiuse') }}">Storico pianificazioni</a>
        {% endif %}
        {% if pan_role == 'admin' %}
        <div class="pan-nav-caption mt-3">Amministrazione</div>
        <a class="pan-nav-item" href="{{ url_for('ordini_cliente.impostazioni_index') }}">Impostazioni</a>
        <a class="pan-nav-item" href="{{ url_for('ordini_cliente.admin_utenti') }}">Utenti e ruoli</a>
        {% endif %}
    </div>
</nav>
{% endif %}
<main class="container-fluid pan-main">
{% if pan_logged_in %}
<nav class="nav nav-tabs pan-tabs pan-app-tabs" aria-label="Sezioni applicazione">
    <a class="nav-link {{ 'active' if request.endpoint == 'ordini_cliente.ordini_cliente' else '' }}" href="{{ url_for('ordini_cliente.ordini_cliente') }}" {% if request.endpoint == 'ordini_cliente.ordini_cliente' %}aria-current="page"{% endif %}>Ordini</a>
    <a class="nav-link {{ 'active' if request.endpoint == 'ordini_cliente.ordini_calendario' else '' }}" href="{{ url_for('ordini_cliente.ordini_calendario') }}" {% if request.endpoint == 'ordini_cliente.ordini_calendario' %}aria-current="page"{% endif %}>Calendario produzione</a>
    {% if pan_can_produce %}
    <a class="nav-link {{ 'active' if request.endpoint == 'ordini_cliente.calendario_macchine' else '' }}" href="{{ url_for('ordini_cliente.calendario_macchine') }}" {% if request.endpoint == 'ordini_cliente.calendario_macchine' %}aria-current="page"{% endif %}>Impiego macchine</a>
    <a class="nav-link {{ 'active' if request.endpoint == 'ordini_cliente.stock_articoli' else '' }}" href="{{ url_for('ordini_cliente.stock_articoli') }}" {% if request.endpoint == 'ordini_cliente.stock_articoli' %}aria-current="page"{% endif %}>Stock</a>
    <a class="nav-link {{ 'active' if request.endpoint == 'ordini_cliente.pianificazioni_chiuse' else '' }}" href="{{ url_for('ordini_cliente.pianificazioni_chiuse') }}" {% if request.endpoint == 'ordini_cliente.pianificazioni_chiuse' %}aria-current="page"{% endif %}>Storico</a>
    {% endif %}
    {% if pan_role == 'admin' %}
    <a class="nav-link {{ 'active' if request.endpoint == 'ordini_cliente.impostazioni_pagina' or request.endpoint == 'ordini_cliente.impostazioni_index' else '' }}" href="{{ url_for('ordini_cliente.impostazioni_index') }}">Impostazioni</a>
    <a class="nav-link {{ 'active' if request.endpoint == 'ordini_cliente.admin_utenti' else '' }}" href="{{ url_for('ordini_cliente.admin_utenti') }}">Utenti</a>
    {% endif %}
</nav>
{% endif %}
    {% with messages = get_flashed_messages(with_categories=true) %}
        {% if messages %}
            <div class="pan-flash-region" aria-live="polite">
            {% for category, message in messages %}
                {% set bootstrap_category = 'danger' if category in ('error', 'danger') else 'success' if category == 'success' else 'warning' if category == 'warning' else 'info' %}
                <div class="alert alert-{{ bootstrap_category }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Chiudi"></button>
                </div>
            {% endfor %}
            </div>
        {% endif %}
    {% endwith %}
    {% block content %}{% endblock %}
</main>
<div id="htmx-global"></div>
{% block scripts %}
    <script src="{{ url_for('static', filename='vendor/fullcalendar-7.1.0/dist/fullcalendar.global.js') }}"></script>
    <script src="{{ url_for('static', filename='vendor/htmx/htmx.min.js') }}"></script>
    <script src="{{ url_for('static', filename='vendor/bootstrap-5.0.2-dist/js/bootstrap.bundle.min.js') }}"></script>
    <script src="{{ url_for('static', filename='js/modal.js') }}"></script>
{% endblock %}
</body>
</html>
