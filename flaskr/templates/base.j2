<!doctype html>
<html lang="it">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Ordini Panettoni{% endblock %}</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='vendor/bootstrap-5.0.2-dist/css/bootstrap.min.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/style.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', filename='vendor/fullcalendar-7.1.0/dist/skeleton.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', filename='vendor/fullcalendar-7.1.0/dist/themes/forma/theme.css') }}">
    {# Tema ricavato dal gestionale Vendite, isolato sul nuovo applicativo. #}
    <link rel="stylesheet" href="{{ url_for('static', filename='css/tema_panettoni.css', v='20261021-4') }}">
    {% block head %}{% endblock %}
</head>
<body class="pan-app-body">
{% set pan_logged_in = g is defined and g.user is defined and g.user is not none %}
{% set pan_role = ruolo_corrente|default('', true) %}
{% set pan_can_produce = puo_gestire_produzione|default(false) or pan_role in ('admin', 'utente_produzione') %}
{% if pan_logged_in %}
<header class="pan-app-header" role="banner">
    <div class="pan-app-header-inner">
        <div class="pan-header-menu">
            <button class="btn btn-light pan-menu-button" type="button" data-bs-toggle="offcanvas" data-bs-target="#pan-navigation" aria-controls="pan-navigation" aria-label="Apri menu di navigazione" title="Apri menu di navigazione">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
            </button>
        </div>
        <div class="pan-header-identity">
            <span class="pan-header-role">
            {% if pan_role == 'admin' %}Amministrazione{% elif pan_role == 'utente_produzione' %}Produzione{% elif pan_role == 'utente_vendite' %}Vendite{% else %}Gestione ordini{% endif %}
            </span>
            <span class="pan-header-separator" aria-hidden="true">·</span>
            <strong class="pan-header-user">{{ g.user.username }}</strong>
        </div>
        <div class="pan-header-brand" aria-label="Ordini Panettoni">
            <span class="pan-brand-symbol" aria-hidden="true">OP</span>
            <span class="pan-brand-text">Ordini <strong>Panettoni</strong></span>
        </div>
    </div>
</header>
<nav class="offcanvas offcanvas-start pan-offcanvas" id="pan-navigation" tabindex="-1" aria-labelledby="pan-navigation-title">
    <div class="offcanvas-header border-bottom">
        <h2 class="offcanvas-title h5 mb-0" id="pan-navigation-title">Navigazione</h2>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Chiudi"></button>
    </div>
    <div class="offcanvas-body">
        {% set pan_current_endpoint = request.endpoint|default('', true) %}
        {% set pan_is_orders = pan_current_endpoint in ('ordini_cliente.ordini_cliente', 'ordini_cliente.note_vendite_ordine', 'ordini_cliente.gestione_pianificazione') %}
        {% set pan_is_calendar = pan_current_endpoint == 'ordini_cliente.ordini_calendario' %}
        {% set pan_is_machines = pan_current_endpoint == 'ordini_cliente.calendario_macchine' %}
        {% set pan_is_stock = pan_current_endpoint == 'ordini_cliente.stock_articoli' %}
        {% set pan_is_history = pan_current_endpoint == 'ordini_cliente.pianificazioni_chiuse' %}
        {% set pan_is_settings = pan_current_endpoint in ('ordini_cliente.impostazioni_index', 'ordini_cliente.impostazioni_pagina') %}
        {% set pan_is_users = pan_current_endpoint == 'ordini_cliente.admin_utenti' %}
        <div class="pan-nav-caption">Consultazione</div>
        <a class="pan-nav-item{{ ' is-active' if pan_is_orders else '' }}" href="{{ url_for('ordini_cliente.ordini_cliente') }}" {% if pan_is_orders %}aria-current="page"{% endif %}>Gestione ordini</a>
        <a class="pan-nav-item{{ ' is-active' if pan_is_calendar else '' }}" href="{{ url_for('ordini_cliente.ordini_calendario') }}" {% if pan_is_calendar %}aria-current="page"{% endif %}>Calendario produzione</a>
        {% if pan_can_produce %}
        <div class="pan-nav-caption mt-3">Produzione</div>
        <a class="pan-nav-item{{ ' is-active' if pan_is_machines else '' }}" href="{{ url_for('ordini_cliente.calendario_macchine') }}" {% if pan_is_machines %}aria-current="page"{% endif %}>Impiego impastatrici</a>
        <a class="pan-nav-item{{ ' is-active' if pan_is_stock else '' }}" href="{{ url_for('ordini_cliente.stock_articoli') }}" {% if pan_is_stock %}aria-current="page"{% endif %}>Stock panettoni</a>
        <a class="pan-nav-item{{ ' is-active' if pan_is_history else '' }}" href="{{ url_for('ordini_cliente.pianificazioni_chiuse') }}" {% if pan_is_history %}aria-current="page"{% endif %}>Storico pianificazioni</a>
        {% endif %}
        {% if pan_role == 'admin' %}
        <div class="pan-nav-caption mt-3">Amministrazione</div>
        <a class="pan-nav-item{{ ' is-active' if pan_is_settings else '' }}" href="{{ url_for('ordini_cliente.impostazioni_index') }}" {% if pan_is_settings %}aria-current="page"{% endif %}>Impostazioni</a>
        <a class="pan-nav-item{{ ' is-active' if pan_is_users else '' }}" href="{{ url_for('ordini_cliente.admin_utenti') }}" {% if pan_is_users %}aria-current="page"{% endif %}>Utenti e ruoli</a>
        {% endif %}
    </div>
</nav>
{% endif %}
<main class="container-fluid pan-main">
{% with messages = get_flashed_messages(with_categories=true) %}
        {% if messages %}
            <div class="pan-flash-region" aria-live="polite">
            {% for category, message in messages %}
                {% set bootstrap_category = 'danger' if category in ('error', 'danger') else 'success' if category == 'success' else 'warning' if category == 'warning' else 'info' %}
                <div class="alert alert-{{ bootstrap_category }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Chiudi"></button>
                </div>
            {% endfor %}
            </div>
        {% endif %}
    {% endwith %}
    {% block content %}{% endblock %}
</main>
<div id="htmx-global"></div>
{% block scripts %}
    <script src="{{ url_for('static', filename='vendor/fullcalendar-7.1.0/dist/fullcalendar.global.js') }}"></script>
    <script src="{{ url_for('static', filename='vendor/htmx/htmx.min.js') }}"></script>
    <script src="{{ url_for('static', filename='vendor/bootstrap-5.0.2-dist/js/bootstrap.bundle.min.js') }}"></script>
    <script src="{{ url_for('static', filename='js/modal.js') }}"></script>
{% endblock %}
</body>
</html>
