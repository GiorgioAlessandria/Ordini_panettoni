{# Riepilogo compatto esclusivo della barra "Ordini da gestire".
   Non modifica _riepilogo_contenuto.j2 usato nei dettagli della pianificazione. #}
{% if riepilogo_misto is defined and riepilogo_misto %}
    <div class="ordini-riepilogo-linea" role="status" aria-label="Riepilogo impasto misto">
      <span class="ordini-riepilogo-voce">Impasto misto: <strong>{{ riepilogo_misto.gruppo }}</strong></span>
      <span class="ordini-riepilogo-voce">Ordini <strong>{{ riepilogo_misto.numero_ordini }}</strong></span>
      <span class="ordini-riepilogo-voce">Articoli <strong>{{ riepilogo_misto.numero_articoli }}</strong></span>
      <span class="ordini-riepilogo-voce">Pezzi disponibili <strong>{{ riepilogo_misto.quantita }}</strong></span>
      <span class="ordini-riepilogo-voce">Impasto previsto <strong>{{ '%.2f'|format(riepilogo_misto.peso_impasto_kg) }} kg</strong></span>
    </div>
{% elif errore %}
    <span class="small {{ 'text-muted' if errore == 'Nessun ordine selezionato' else 'text-danger' }}" role="status">{{ errore }}</span>
{% elif riepilogo %}
    <div class="ordini-riepilogo-linea" role="status" aria-label="Riepilogo ordini selezionati">
        <span class="ordini-riepilogo-voce">Ordini <strong>{{ riepilogo.numero_ordini }}</strong></span>
        <span class="ordini-riepilogo-voce">Panettoni disponibili <strong>{{ riepilogo.qta_panettoni }}</strong></span>
        <span class="ordini-riepilogo-voce">Cotte <strong>{{ riepilogo.numero_cotte }}</strong> <span class="text-muted">({{ riepilogo.capienza_cotta }} pz/cotta)</span></span>
        <span class="ordini-riepilogo-voce" title="Panettoni necessari per completare l'ultima cotta">Da completare <strong>{{ riepilogo.panettoni_mancanti_cotta }}</strong></span>
        <span class="ordini-riepilogo-voce">Impasto <strong>{{ '%.2f' | format(riepilogo.peso_impasto) }} kg</strong></span>
    </div>
{% endif %}
