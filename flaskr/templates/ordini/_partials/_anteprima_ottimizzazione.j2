{% if error %}
<div class="alert alert-danger mb-0" role="alert">{{ error }}</div>
{% else %}
{% include 'ordini/_partials/_riepilogo_contenuto.j2' %}
<div class="mt-3 border-top pt-3 pan-simulation">
    <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap mb-2">
        <h6 class="mb-0 fw-semibold">Simulazione produttiva</h6>
        {% if simulazione.ottimizzata %}
        <span class="badge bg-primary">Cotte ottimizzate</span>
        {% else %}
        <span class="badge bg-secondary">Produzione ordinaria</span>
        {% endif %}
    </div>
    <div class="row g-2">
        <div class="col-6 col-xl-3"><div class="pianificazione-indicatore pan-kpi">
            <small class="text-secondary d-block">Pezzi richiesti dagli ordini</small><strong>{{ simulazione.pezzi_ordine }}</strong>
        </div></div>
        <div class="col-6 col-xl-3"><div class="pianificazione-indicatore pan-kpi">
            <small class="text-secondary d-block">Produzione effettiva</small><strong>{{ simulazione.pezzi_produzione }}</strong>
        </div></div>
        <div class="col-6 col-xl-3"><div class="pianificazione-indicatore pan-kpi">
            <small class="text-secondary d-block">Cotte richieste</small><strong>{{ simulazione.numero_cotte }}</strong>
            <small class="text-secondary">Max {{ simulazione.max_cotte }}</small>
        </div></div>
        <div class="col-6 col-xl-3"><div class="pianificazione-indicatore pan-kpi {% if simulazione.pezzi_stock %}border-primary{% endif %}">
            <small class="text-secondary d-block">Surplus per stock</small><strong>{{ simulazione.pezzi_stock }}</strong>
        </div></div>
    </div>
    <div class="alert alert-light border py-2 mt-2 mb-1 small pan-muted-box">
        <strong>Ripartizione quantità:</strong>
        {{ simulazione.pezzi_ordine }} ordinati − {{ simulazione.pezzi_stock_utilizzati }} da stock
        = {{ simulazione.pezzi_da_produrre }} da produrre per gli ordini;
        {{ simulazione.pezzi_stock }} pezzi extra da ottimizzazione.
        <div>Stock prima della conferma: {{ stock_disponibile }} pezzi · Stock previsto dopo: {{ stock_disponibile - simulazione.pezzi_stock_utilizzati + simulazione.pezzi_stock }}.</div>
    </div>
    <div class="small mt-2 d-flex flex-wrap gap-3">
        <span>Peso unitario con coefficienti: <strong>{{ '%.2f'|format(simulazione.peso_unitario_grammi) }} g</strong></span>
        <span>Peso totale dell'impasto: <strong>{{ '%.2f'|format(simulazione.peso_totale_kg) }} kg</strong></span>
    </div>
    {% if simulazione.pezzi_stock %}
    <div class="alert alert-info small mt-2 mb-0">
        Articolo <strong>{{ riepilogo.codart_ordine }}</strong>: alla conferma verranno aggiunti
        <strong>{{ simulazione.pezzi_stock }} pezzi</strong> alla riga Stock esistente, oppure ne sarà creata una nuova.
    </div>
    {% else %}
    <p class="small text-secondary mt-2 mb-0">Nessuna quantità aggiuntiva per lo stock.</p>
    {% endif %}
</div>
{% endif %}
