{# Riepilogo scadenze: commenti sempre e solo in lettura, anche per admin/vendite. #}
{# Lo stato è calcolato dal backend in base alle pianificazioni valide. #}
<style>
  /* Stato intermedio: almeno una quantità è stata pianificata. */
  .scad-giorno .scad-stato-etichetta.scad-stato-carico {
    background-color: #e0efff;
    border: 1px solid #93b7f2;
    color: #174a8b;
  }
  .scad-giorno .scad-stato-dot.scad-stato-carico {
    background-color: #2563eb;
    border-color: #2563eb;
  }
</style>
<section class="scad-giorno" aria-label="Scadenze {{ giorno.strftime('%d/%m/%Y') }}">
  <div class="scad-giorno-heading">
    <div>
      <h3 class="h5 mb-1">Scadenze del {{ giorno.strftime('%d/%m/%Y') }}</h3>
      <p class="text-secondary small mb-0">{{ righe|length }} ordini · {{ eseguiti }} eseguiti · {{ righe|length - eseguiti }} da eseguire</p>
    </div>
    <div class="scad-giorno-legenda" aria-label="Legenda degli stati">
      <span><i class="scad-stato-dot scad-stato-eseguito"></i> Eseguito</span>
      <span><i class="scad-stato-dot scad-stato-carico"></i> Preso in carico</span>
      <span><i class="scad-stato-dot scad-stato-attesa"></i> Nuovo</span>
    </div>
  </div>
  <div class="table-responsive scad-giorno-tabella" role="region" aria-label="Ordini in scadenza per il giorno selezionato" tabindex="0">
    <table class="table table-sm table-bordered align-middle mb-0">
      <thead>
        <tr>
          <th scope="col">Ordine</th>
          <th scope="col">Cliente</th>
          <th scope="col">Articolo</th>
          <th scope="col" class="text-end">Q.tà ordinata</th>
          <th scope="col" class="text-end">Q.tà da eseguire</th>
          <th scope="col">Stato</th>
          <th scope="col" class="scad-col-note">Commenti vendite</th>
          <th scope="col" class="scad-col-note">Commenti produzione</th>
        </tr>
      </thead>
      <tbody>
        {% for voce in righe %}
          {% set ordine = voce.ordine %}
          {% set id_documento = ordine.IdDocumento %}
          {% set id_riga = ordine.IdRigaDoc %}
          {% set note = note_per_ordine.get((id_documento, id_riga), []) %}
          {% set nota_corrente = note[0] if note else none %}
          {% set note_produzione = note_produzione_per_ordine.get((id_documento, id_riga), []) %}
          {% set nota_produzione_corrente = note_produzione[0] if note_produzione else none %}
          {% set stato = voce.stato_calendario %}
          <tr class="{{ 'scad-riga-eseguita' if voce.eseguito else 'scad-riga-da-eseguire' }}{{ ' scad-riga-carico' if stato == 'Preso in carico' else '' }}">
            <td class="text-nowrap fw-semibold">{{ id_documento }}-{{ id_riga }}</td>
            <td>{{ ordine.Cliente.RagioneSociale if ordine.Cliente else 'N/D' }}</td>
            <td><strong>{{ ordine.CodArt }}</strong><div class="small">{{ ordine.DesArt or '' }}</div></td>
            <td class="text-end">{{ ordine.QTA_ORD or 0 }}</td>
            <td class="text-end fw-semibold">{{ [0, (ordine.QTA_SALDO_DOC or 0)|int - voce.quantita_chiusa]|max }}</td>
            <td>
              <span class="scad-stato-etichetta {{ 'scad-stato-eseguito' if stato == 'Eseguito' else ('scad-stato-carico' if stato == 'Preso in carico' else 'scad-stato-attesa') }}">
                {{ stato }}
              </span>
            </td>
            <td class="scad-col-note">
              {% if nota_corrente %}
                <div class="scad-commento-lettura" style="white-space:pre-wrap">{{ nota_corrente.Testo }}</div>
                <small class="text-secondary">{{ nota_corrente.AutoreNome }}</small>
              {% else %}
                <span class="text-secondary small">—</span>
              {% endif %}
            </td>
            <td class="scad-col-note">
              {% if nota_produzione_corrente %}
                <div class="scad-commento-lettura" style="white-space:pre-wrap">{{ nota_produzione_corrente.Testo }}</div>
                <small class="text-secondary">{{ nota_produzione_corrente.AutoreNome }}</small>
              {% else %}
                <span class="text-secondary small">—</span>
              {% endif %}
              <div class="mt-1"><a class="small" href="{{ url_for('ordini_cliente.note_produzione_ordine', id_documento=id_documento, id_riga=id_riga) }}">Apri commenti</a></div>
            </td>
          </tr>
        {% else %}
          <tr><td colspan="8" class="text-center text-secondary p-3">Nessuna scadenza per questa data.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  <p class="small text-secondary mt-2 mb-0">Verde: ordine eseguito. Blu: almeno una quantità presa in carico da una pianificazione valida, anche parziale. Arancione: nessuna quantità ancora pianificata. La colonna «Q.tà da eseguire» continua a basarsi sulle produzioni chiuse.</p>
</section>
