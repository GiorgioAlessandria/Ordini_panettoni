{# Frammento usato da entrambe le route; stato_tabella = Nuovo / In produzione. #}
{% set selezione_attiva = (stato_tabella == 'Nuovo') %}
{% set prezzature = ordini_cliente | map(attribute='Prezzatura') | unique | sort | list %}
{% set pianificazioni = ordini_cliente | map(attribute='IdPianificazione') | reject('none') | unique | sort | list %}
{# Un'unica query per recuperare i commenti di tutti gli ordini presenti in tabella. #}
{% set note_per_ordine = note_vendite_per_righe(ordini_cliente, selezione_attiva) %}
{% macro colonna(key, nome, tipo='text') %}
    <th scope="col" aria-sort="none" data-sort-column="{{ key }}" data-col="{{ key }}">
        <button type="button" class="ordini-sort" data-sort-key="{{ key }}" data-sort-type="{{ tipo }}"
                aria-label="Ordina per {{ nome }}">
            {{ nome }} <span class="ordini-sort-indicator" aria-hidden="true">↕</span>
        </button>
    </th>
{% endmacro %}

<div id="{{ 'form-ordini' if selezione_attiva else 'form-ordini-produzione' }}"
      class="ordini-form pan-orders-form" data-tipo-tabella="{{ stato_tabella }}">
    <div class="ordini-filtri pan-toolbar" role="group" aria-label="Filtri ordini {{ stato_tabella }}">
        <div class="ordini-filtro ricerca">
            <label for="filtro-ricerca-{{ 'nuovo' if selezione_attiva else 'produzione' }}">Ricerca</label>
            <input id="filtro-ricerca-{{ 'nuovo' if selezione_attiva else 'produzione' }}"
                   class="form-control form-control-sm" type="search" data-filter="ricerca"
                   placeholder="Cliente, articolo, ordine..." autocomplete="off">
        </div>
        <div class="ordini-filtro">
            <label for="filtro-prezzatura-{{ 'nuovo' if selezione_attiva else 'produzione' }}">Prezzatura</label>
            <select id="filtro-prezzatura-{{ 'nuovo' if selezione_attiva else 'produzione' }}"
                    class="form-select form-select-sm" data-filter="prezzatura">
                <option value="">Tutte</option>
                {% for valore in prezzature %}
                    <option value="{{ valore }}">{{ valore }} g</option>
                {% endfor %}
            </select>
        </div>
        <div class="ordini-filtro">
            <label for="filtro-glassa-{{ 'nuovo' if selezione_attiva else 'produzione' }}">Glassa</label>
            <select id="filtro-glassa-{{ 'nuovo' if selezione_attiva else 'produzione' }}"
                    class="form-select form-select-sm" data-filter="glassa">
                <option value="">Tutte</option>
                <option value="Si">Sì</option>
                <option value="No">No</option>
            </select>
        </div>
        {% if selezione_attiva %}
            <div class="ordini-filtro">
                <label for="filtro-priorita">Priorità</label>
                <select id="filtro-priorita" class="form-select form-select-sm" data-filter="priorita">
                    <option value="">Tutte</option>
                    <option value="1">P1 · Alta</option>
                    <option value="2">P2 · Media</option>
                    <option value="3">P3 · Bassa</option>
                    <option value="none">Nessuna</option>
                </select>
            </div>
            <div class="ordini-filtro">
                <label for="filtro-parziale">Residuo</label>
                <select id="filtro-parziale" class="form-select form-select-sm" data-filter="parziale">
                    <option value="">Tutti</option>
                    <option value="si">Parziali</option>
                    <option value="no">Completi</option>
                </select>
            </div>
        {% else %}
            <div class="ordini-filtro">
                <label for="filtro-piano">Pianificazione</label>
                <select id="filtro-piano" class="form-select form-select-sm" data-filter="pianificazione">
                    <option value="">Tutte</option>
                    {% for piano in pianificazioni %}
                        <option value="{{ piano }}">#{{ piano }}</option>
                    {% endfor %}
                </select>
            </div>
        {% endif %}
        <div class="ordini-filtro">
            <label for="filtro-dal-{{ 'nuovo' if selezione_attiva else 'produzione' }}">Consegna dal</label>
            <input id="filtro-dal-{{ 'nuovo' if selezione_attiva else 'produzione' }}"
                   class="form-control form-control-sm" type="date" data-filter="dal">
        </div>
        <div class="ordini-filtro">
            <label for="filtro-al-{{ 'nuovo' if selezione_attiva else 'produzione' }}">Consegna al</label>
            <input id="filtro-al-{{ 'nuovo' if selezione_attiva else 'produzione' }}"
                   class="form-control form-control-sm" type="date" data-filter="al">
        </div>
        <button type="button" class="btn btn-outline-secondary btn-sm ordini-reset" data-reset-filters>
            Azzera filtri
        </button>
    </div>

    <div class="ordini-barra pan-meta">
        <span data-contatore-righe>{{ ordini_cliente|length }} ordini</span>
        {% if selezione_attiva %}
            <span class="ordini-legenda">Residuo inferiore all'ordinato</span>
        {% else %}
            <span>Scorri in orizzontale per leggere tutte le colonne.</span>
        {% endif %}
    </div>

    <div class="ordini-table-scroll pan-orders-table-wrap" tabindex="0" role="region" aria-label="Tabella {{ stato_tabella }} scorrevole orizzontalmente e verticalmente">
        <table class="table table-striped table-hover align-middle ordini-table pan-table">
            <thead>
                <tr>
                    {% if selezione_attiva %}
                        <th scope="col" class="col-centro" data-col="seleziona">Seleziona</th>
                        {{ colonna('priorita', 'Priorità', 'number') }}
                    {% else %}
                        {{ colonna('pianificazione', 'Pianificazione', 'number') }}
                    {% endif %}
                    {{ colonna('cliente', 'Cliente') }}
                    {{ colonna('articolo', 'Codice panettone') }}
                    {{ colonna('descrizione', 'Descrizione') }}
                    {{ colonna('consegna', 'Consegna', 'date') }}
                    {{ colonna('ordinata', 'Q.tà ordinata' if selezione_attiva else 'Tot. ordinato', 'number') }}
                    {{ colonna('quantita', 'Q.tà residua' if selezione_attiva else 'Q.tà assegnata', 'number') }}
                    {{ colonna('prezzatura', 'Prezzatura', 'number') }}
                    {{ colonna('glassa', 'Glassa') }}
                    {{ colonna('stato', 'Stato') }}
                    <th scope="col" class="pan-note-col-heading" data-col="commenti">Commenti vendite</th>
                    {% if not selezione_attiva %}<th scope="col" data-col="azioni">Azioni</th>{% endif %}
                </tr>
            </thead>
            <tbody>
                {% for ordine in ordini_cliente %}
                    {% set consegna_iso = ordine.DataConsegna[6:10] ~ '-' ~ ordine.DataConsegna[3:5] ~ '-' ~ ordine.DataConsegna[0:2] %}
                    <tr data-record
                        {% if selezione_attiva and ordine.ResiduoParziale %}class="ordini-riga-parziale"{% endif %}
                        data-original-index="{{ loop.index0 }}"
                        data-commenti-ordini="{% if selezione_attiva %}{{ ordine.IdDocumento }}:{{ ordine.IdRigaDoc }}{% else %}{% for voce in ordine.OrdiniDettaglio %}{{ voce.IdDocumento }}:{{ voce.IdRigaDoc }}{% if not loop.last %},{% endif %}{% endfor %}{% endif %}"
                        data-id-documento="{{ ordine.IdDocumento }}"
                        data-id-riga="{{ ordine.IdRigaDoc }}"
                        data-id-pianificazione="{{ ordine.IdPianificazione if ordine.IdPianificazione is not none else '' }}"
                        data-filter-text="{{ ordine.Cliente }} {{ ordine.CodArt }} {{ ordine.DesArt }} {{ ordine.IdDocumento }}-{{ ordine.IdRigaDoc }} {% if not selezione_attiva %}{% for voce in ordine.OrdiniDettaglio %}{{ voce.IdDocumento }}-{{ voce.IdRigaDoc }} {% endfor %}{% endif %}"
                        data-filter-priorita="{{ ordine.Priorita if selezione_attiva and ordine.Priorita is not none else 'none' }}"
                        data-filter-parziale="{{ 'si' if selezione_attiva and ordine.ResiduoParziale else 'no' }}"
                        data-filter-prezzatura="{{ ordine.Prezzatura }}"
                        data-filter-glassa="{{ ordine.Glassatura }}"
                        data-filter-consegna="{{ consegna_iso }}"
                        data-filter-pianificazione="{{ ordine.IdPianificazione if ordine.IdPianificazione is not none else '' }}"
                        {% if selezione_attiva %}
                        hx-get="{{ url_for('ordini_cliente.dettaglio_ordine', IdDocumento=ordine.IdDocumento, IdRigaDoc=ordine.IdRigaDoc) }}"
                        hx-trigger="click"
                        hx-target="#htmx-global"
                        hx-swap="innerHTML"
                        tabindex="0"
                        aria-label="Dettaglio ordine {{ ordine.IdDocumento }}-{{ ordine.IdRigaDoc }}"
                        {% else %}
                        aria-label="Pianificazione {{ ordine.IdPianificazione }} con {{ ordine.NumeroOrdini }} ordini"
                        {% endif %}>
                        {% if selezione_attiva %}
                            <td class="col-centro" data-col="seleziona">
                                {% if puo_gestire_produzione %}
                                <input type="checkbox" name="ordini_selezionati"
                                       value="{{ ordine.IdDocumento }}-{{ ordine.IdRigaDoc }}"
                                       data-cod-art="{{ ordine.CodArt }}"
                                       data-prezzatura="{{ ordine.Prezzatura }}"
                                       hx-post="{{ url_for('ordini_cliente.riepilogo_selezione') }}"
                                       hx-trigger="change"
                                       hx-include="closest .ordini-form" hx-params="ordini_selezionati"
                                       hx-target="#riepilogo-ordini"
                                       hx-swap="innerHTML"
                                       onclick="event.stopPropagation()"
                                       aria-label="Seleziona ordine {{ ordine.IdDocumento }}-{{ ordine.IdRigaDoc }}">
                                {% else %}—{% endif %}
                            </td>
                            <td data-col="priorita"
                                data-sort-value="{{ ordine.Priorita if ordine.Priorita is not none else 99 }}">
                                {% if puo_gestire_produzione %}
                                <select name="priorita_{{ ordine.IdDocumento }}_{{ ordine.IdRigaDoc }}"
                                        class="form-select form-select-sm ordini-priorita-select"
                                        data-priorita-input
                                        data-priority-level="{{ ordine.Priorita if ordine.Priorita is not none else '' }}"
                                        data-prev-value="{{ ordine.Priorita if ordine.Priorita is not none else '' }}"
                                        hx-post="{{ url_for('ordini_cliente.aggiorna_priorita_ordine', IdDocumento=ordine.IdDocumento, IdRigaDoc=ordine.IdRigaDoc) }}"
                                        hx-trigger="change"
                                        hx-params="priorita_{{ ordine.IdDocumento }}_{{ ordine.IdRigaDoc }}"
                                        hx-swap="none"
                                        onclick="event.stopPropagation()"
                                        aria-label="Priorità ordine {{ ordine.IdDocumento }}-{{ ordine.IdRigaDoc }}">
                                    <option value="" {% if ordine.Priorita is none %}selected{% endif %}>Nessuna</option>
                                    <option value="1" {% if ordine.Priorita == 1 %}selected{% endif %}>P1 · Alta</option>
                                    <option value="2" {% if ordine.Priorita == 2 %}selected{% endif %}>P2 · Media</option>
                                    <option value="3" {% if ordine.Priorita == 3 %}selected{% endif %}>P3 · Bassa</option>
                                </select>
                                {% else %}{{ 'P' ~ ordine.Priorita if ordine.Priorita is not none else 'Nessuna' }}{% endif %}
                            </td>
                        {% else %}
                            <td data-col="pianificazione" data-sort-value="{{ ordine.IdPianificazione }}" class="col-numero">
                                <strong>#{{ ordine.IdPianificazione }}</strong>
                                <div class="piano-riepilogo">{{ ordine.NumeroOrdini }} ordini</div>
                                <details class="piano-dettagli" onclick="event.stopPropagation()">
                                    <summary>Mostra ordini</summary>
                                    <ul class="piano-ordini-elenco">
                                        {% for voce in ordine.OrdiniDettaglio %}
                                            <li>
                                                <button type="button" class="btn btn-link btn-sm p-0 align-baseline"
                                                        hx-get="{{ url_for('ordini_cliente.dettaglio_ordine', IdDocumento=voce.IdDocumento, IdRigaDoc=voce.IdRigaDoc) }}"
                                                        hx-target="#htmx-global" hx-swap="innerHTML"
                                                        onclick="event.stopPropagation()">
                                                    {{ voce.IdDocumento }}-{{ voce.IdRigaDoc }}
                                                </button>
                                                · {{ voce.Cliente }} · {{ voce.QtaPianificata }} pz
                                                · {{ voce.DataConsegna }}
                                            </li>
                                        {% endfor %}
                                    </ul>
                                </details>
                            </td>
                        {% endif %}
                        <td data-col="cliente" title="{{ ordine.Cliente }}">
                            {% if selezione_attiva %}{{ ordine.Cliente }}{% else %}<span class="piano-plurale">{{ ordine.Cliente }}</span>{% endif %}
                        </td>
                        <td data-col="articolo">{{ ordine.CodArt }}
                        </td>
                        <td data-col="descrizione" title="{{ ordine.DesArt }}">{% if selezione_attiva %}{{ ordine.DesArt }}{% else %}<span class="piano-plurale">{{ ordine.DesArt }}</span>{% endif %}</td>
                        <td data-col="consegna" data-sort-value="{{ consegna_iso }}" title="{% if selezione_attiva %}Consegna{% else %}Dalla prima all'ultima scadenza: {{ ordine.DataConsegna }} – {{ ordine.ConsegnaUltima }}{% endif %}">{{ ordine.DataConsegna }}{% if not selezione_attiva and ordine.ConsegnaUltima != ordine.DataConsegna %}<br><small>– {{ ordine.ConsegnaUltima }}</small>{% endif %}</td>
                        <td data-col="ordinata" data-sort-value="{{ ordine.QTA_ORD }}" class="col-numero">{{ ordine.QTA_ORD }}</td>
                        <td data-col="quantita" data-sort-value="{{ ordine.QTA_Saldo }}" class="col-numero fw-semibold">{{ ordine.QTA_Saldo }}</td>
                        <td data-col="prezzatura" data-sort-value="{{ ordine.Prezzatura }}" class="col-numero">{{ ordine.Prezzatura }} g</td>
                        <td data-col="glassa">{{ ordine.Glassatura }}</td>
                        <td data-col="stato">{{ ordine.Stato }}</td>
                        <td data-col="commenti" class="pan-note-cell" onclick="event.stopPropagation()">
                            {% if selezione_attiva %}
                                {% with id_documento=ordine.IdDocumento, id_riga=ordine.IdRigaDoc, note=note_per_ordine.get((ordine.IdDocumento, ordine.IdRigaDoc), []) %}
                                    {% include 'ordini/_partials/_note_vendite_cella.j2' %}
                                {% endwith %}
                            {% else %}
                                <div class="pan-notes-group">
                                {% for voce in ordine.OrdiniDettaglio %}
                                    <div class="pan-notes-group-item">
                                        <span class="pan-note-order-label">Ordine {{ voce.IdDocumento }}-{{ voce.IdRigaDoc }}</span>
                                        {% with id_documento=voce.IdDocumento, id_riga=voce.IdRigaDoc, note=note_per_ordine.get((voce.IdDocumento, voce.IdRigaDoc), []) %}
                                            {% include 'ordini/_partials/_note_vendite_cella.j2' %}
                                        {% endwith %}
                                    </div>
                                {% else %}
                                    <span class="text-secondary small">Nessun ordine associato.</span>
                                {% endfor %}
                                </div>
                            {% endif %}
                        </td>
                        {% if not selezione_attiva %}
                        <td data-col="azioni">
                            {% if puo_gestire_produzione %}<a class="btn btn-outline-primary btn-sm"
                               href="{{ url_for('ordini_cliente.gestione_pianificazione', IdPianificazione=ordine.IdPianificazione) }}"
                               onclick="event.stopPropagation()">Gestisci / chiudi</a>{% else %}<span class="text-secondary">Sola lettura</span>{% endif %}
                        </td>
                        {% endif %}
                    </tr>
                {% else %}
                    <tr data-no-data><td colspan="12" class="text-center py-4">Nessun ordine da visualizzare.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
