{% if error %}
<div class="modal-header">
    <h5 class="modal-title">Pianificazione produzione</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Chiudi"></button>
</div>
<div class="modal-body"><div class="alert alert-danger" role="alert">{{ error }}</div></div>
{% else %}
<style>
    #modal-pianificazione .modal-dialog { max-width: min(1360px, 97vw); }
    #modal-pianificazione .modal-content { max-height: calc(100dvh - 2rem); display: flex; flex-direction: column; }
    #form-pianificazione { display: flex; flex: 1 1 auto; min-height: 0; overflow: hidden; flex-direction: column; }
    #form-pianificazione > .modal-body { overflow: auto; min-height: 0; flex: 1 1 auto; }
    #form-pianificazione > .modal-footer { flex: 0 0 auto; background: #fff; border-top: 1px solid #dce4ed; z-index: 3; }
    #form-pianificazione .pianificazione-riepilogo { overflow: visible; }
    #form-pianificazione .pianificazione-pannello { border: 1px solid #dce4ed; border-radius: .8rem; background: #fff; padding: 1rem; min-width: 0; }
    #form-pianificazione .pianificazione-impostazioni { background: #f8fafc; }
    #form-pianificazione .pianificazione-riepilogo { min-height: 100%; overflow: auto; }
    #form-pianificazione .pianificazione-riepilogo .table-responsive { max-height: 300px !important; overflow: auto; }
    #form-pianificazione .pianificazione-riepilogo th, #form-pianificazione .pianificazione-riepilogo td { font-size: .83rem; }
    #form-pianificazione .pianificazione-selettore { border: 1px solid #dae1e9; border-radius: .5rem; padding: .5rem .65rem; background: white; cursor: pointer; display: flex; align-items: center; gap: .55rem; }
    #form-pianificazione .pianificazione-selettore:hover { border-color: #86b7fe; }
    #form-pianificazione .pianificazione-titolo { font-size: 1rem; font-weight: 700; margin-bottom: .8rem; }
    #form-pianificazione .pianificazione-indicatore { border: 1px solid #dce4ed; border-radius: .55rem; padding: .65rem .8rem; min-height: 80px; background: #f8fafc; }
    #form-pianificazione .pianificazione-indicatore strong { display: block; font-size: 1.35rem; line-height: 1.4; }
    #form-pianificazione .pianificazione-riepilogo .border.rounded-3 { border: 0 !important; padding: 0 !important; }
    @media (max-width: 991.98px) {
        #modal-pianificazione .modal-dialog { max-width: calc(100vw - 1rem); margin: .5rem; }
        #form-pianificazione .pianificazione-pannello { padding: .8rem; }
    }
</style>
<div class="modal-header">
    <div>
        <h5 class="modal-title">Pianificazione produzione</h5>
        <small class="text-secondary">Impostazioni a sinistra; ordini, quantità e simulazione a destra</small>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Chiudi"></button>
</div>
<form id="form-pianificazione"
      hx-post="{{ url_for('ordini_cliente.conferma_pianificazione') }}"
      hx-target="#contenuto-pianificazione"
      hx-swap="innerHTML"
      hx-disabled-elt="find button[type='submit']">
    <div class="modal-body">
        <div class="row g-3 align-items-start">
            <section class="col-12 col-lg-5" aria-labelledby="pianificazione-settings-title">
                <div class="pianificazione-pannello pianificazione-impostazioni">
                    <h6 id="pianificazione-settings-title" class="pianificazione-titolo">Impostazioni della produzione</h6>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="data-inizio-produzione">Data di inizio</label>
                        <input class="form-control" type="date" id="data-inizio-produzione"
                               name="data_inizio_produzione" required>
                    </div>
                    <fieldset class="mb-3">
                        <legend class="form-label fw-semibold fs-6">Blocco iniziale</legend>
                        <div class="d-flex flex-wrap gap-3">
                            <label class="form-check-label"><input class="form-check-input me-1" type="radio" name="blocco_inizio_produzione" value="0" required> Mattina</label>
                            <label class="form-check-label"><input class="form-check-input me-1" type="radio" name="blocco_inizio_produzione" value="1"> Pomeriggio</label>
                        </div>
                    </fieldset>
                    <fieldset class="mb-3">
                        <legend class="form-label fw-semibold fs-6">Impastatrici disponibili</legend>
                        <p class="small text-secondary mb-2">Seleziona le macchine candidate. Il programma distribuirà automaticamente il peso effettivo e prenoterà solo le macchine necessarie.</p>
                        <div class="d-grid gap-2" style="max-height: 190px; overflow-y: auto;">
                            {% for impastatrice in impastatrici %}
                            <label class="pianificazione-selettore">
                                <input class="form-check-input flex-shrink-0 m-0" type="checkbox"
                                       name="impastatrici_selezionate" value="{{ impastatrice.IdImpastatrice }}">
                                <span class="flex-grow-1"><strong>{{ impastatrice.ModelloImpastatrice }}</strong><br><small class="text-secondary">{{ impastatrice.DescrizioneImpastatrice }}</small></span>
                                <span class="badge bg-secondary flex-shrink-0">{{ impastatrice.CapienzaImpastatrice }} {{ impastatrice.UdM }}</span>
                            </label>
                            {% endfor %}
                        </div>
                    </fieldset>
                    <div class="border rounded-3 p-3 bg-white mb-3">
                        <label class="form-label fw-semibold" for="quantita-da-stock">Preleva panettoni già a stock</label>
                        <div class="small text-secondary mb-2">Articolo: {{ riepilogo.codart_ordine }} · disponibili: <strong>{{ stock_disponibile }}</strong> pezzi.</div>
                        <input id="quantita-da-stock" class="form-control" type="number" min="0"
                               max="{{ [stock_disponibile, riepilogo.qta_panettoni - 1]|min }}" step="1"
                               value="0" name="quantita_da_stock" required
                               hx-post="{{ url_for('ordini_cliente.simulazione_pianificazione') }}"
                               hx-trigger="change, keyup changed delay:450ms"
                               hx-include="#form-pianificazione"
                               hx-target="#riepilogo-pianificazione" hx-swap="innerHTML">
                        <small class="text-secondary">Lo stock riduce i pezzi da produrre. Il rimanente viene pianificato con i coefficienti di peso.</small>
                    </div>
                    <div class="border rounded-3 p-3 bg-white">
                        <label class="form-check-label d-flex align-items-start gap-2" for="ottimizza-infornate">
                            <input id="ottimizza-infornate" type="checkbox" class="form-check-input mt-1 flex-shrink-0"
                                   name="ottimizza_infornate" value="1"
                                   hx-post="{{ url_for('ordini_cliente.simulazione_pianificazione') }}"
                                   hx-trigger="change"
                                   hx-include="#form-pianificazione"
                                   hx-target="#riepilogo-pianificazione"
                                   hx-swap="innerHTML"
                                   hx-indicator="#simulazione-attesa">
                            <span><strong>Ottimizza le cotte</strong>
                                <small class="text-secondary d-block">Completa l'ultima cotta. I pezzi in più saranno aggiunti allo stock soltanto dopo la conferma riuscita.</small></span>
                        </label>
                        <span class="small text-secondary htmx-indicator" id="simulazione-attesa">Ricalcolo in corso…</span>
                    </div>
                    <div class="alert alert-warning small mt-3 mb-0" role="note">
                        Il surplus sarà registrato nello stock alla conferma della pianificazione, anche se la produzione fisica non è ancora terminata. Gestire separatamente lo stock realmente disponibile.
                    </div>
                    {% for ordine in ordini_selezionati %}
                    <input type="hidden" name="ordini_selezionati" value="{{ ordine }}">
                    {% endfor %}
                </div>
            </section>
            <section class="col-12 col-lg-7" aria-labelledby="pianificazione-riepilogo-title">
                <div class="pianificazione-pannello pianificazione-riepilogo">
                    <h6 id="pianificazione-riepilogo-title" class="pianificazione-titolo">Ordini selezionati e simulazione</h6>
                    <div id="riepilogo-pianificazione" aria-live="polite">
                        {% include 'ordini/_partials/_anteprima_ottimizzazione.j2' %}
                    </div>
                </div>
            </section>
        </div>
    </div>
    <div class="modal-footer justify-content-between">
        <span class="small text-secondary">Le capacità e la disponibilità saranno nuovamente verificate al salvataggio.</span>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annulla</button>
            <button type="submit" form="form-pianificazione" class="btn btn-primary fw-bold px-4">Conferma pianificazione</button>
        </div>
    </div>
</form>
{% endif %}
