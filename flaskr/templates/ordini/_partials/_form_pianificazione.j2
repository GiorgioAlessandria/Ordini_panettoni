{% if not error %}
<style>
  /* Agenda limitata ai soli giorni attraversati dalle fasi da pianificare. */
  #modal-pianificazione .modal-dialog { max-width: min(96vw, 1480px); }
  #modal-pianificazione .pan-agenda-scroll { overflow-y: auto; max-height: min(63vh, 700px); padding-right: 3px; }
  #modal-pianificazione .pan-agenda-day { border: 1px solid var(--bs-border-color, #dee2e6); border-radius: 8px; margin-bottom: 7px; padding: 7px; }
  #modal-pianificazione .pan-agenda-day-selected { border-color: var(--bs-primary, #0d6efd); background: rgba(13,110,253,.055); }
  #modal-pianificazione .pan-agenda-slot { display: flex; gap: 7px; align-items: flex-start; border-top: 1px solid var(--bs-border-color, #dee2e6); padding-top: 5px; margin-top: 5px; }
  #modal-pianificazione .pan-agenda-slot-marker { flex: 0 0 22px; font-size: .75rem; font-weight: bold; color: var(--bs-secondary-color, #6c757d); }
  #modal-pianificazione .pan-agenda-event { border-left: 3px solid var(--bs-secondary, #6c757d); border-radius: 3px; padding: 3px 6px; margin: 2px 0 5px; background: var(--bs-tertiary-bg, #f8f9fa); font-size: .75rem; overflow-wrap: anywhere; }
  #modal-pianificazione .pan-agenda-impasto { border-left-color: #1976a2; }
  #modal-pianificazione .pan-agenda-forno { border-left-color: #bb6f18; }
  #modal-pianificazione .pan-agenda-event-link { color: inherit; }
  #modal-pianificazione .pan-agenda-proposta {
    border: 2px dashed #e58a00;
    border-radius: 6px;
    background: #fff3de;
    color: #834d00;
    padding: 4px 7px;
  }
  #modal-pianificazione .pan-agenda-proposta small { color: #85511a; }
  #modal-pianificazione .pan-agenda-legend-confirmed { border-left: 3px solid #6c757d; padding-left: 5px; }
  #modal-pianificazione .pan-agenda-legend-draft { border: 2px dashed #e58a00; border-radius: 4px; background: #fff3de; padding: 0px 5px; color: #834d00; }
  @media (max-width: 991.98px) {
    #modal-pianificazione .modal-dialog { max-width: calc(100% - 1rem); }
    #modal-pianificazione .pan-agenda-scroll { max-height: 320px; }
  }
</style>
{% endif %}
{% if error %}
<div class="modal-header pan-modal-header">
    <h5 class="modal-title">Pianificazione produzione</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Chiudi"></button>
</div>
<div class="modal-body"><div class="alert alert-danger" role="alert">{{ error }}</div></div>
{% else %}
<div class="modal-header">
    <div>
        <h5 class="modal-title">Pianificazione produzione</h5>
        <small class="text-secondary">Giornate coinvolte a sinistra; impostazioni al centro; simulazione a destra</small>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Chiudi"></button>
</div>
<form id="form-pianificazione" class="pan-planning-form"
      hx-post="{{ url_for('ordini_cliente.conferma_pianificazione') }}"
      hx-target="#contenuto-pianificazione"
      hx-swap="innerHTML"
      hx-disabled-elt="find button[type='submit']">
    <div class="modal-body">
        <div class="row g-3 align-items-start">
            <section class="col-12 col-lg-3" aria-label="Giornate della nuova pianificazione e produzioni già esistenti">
                <div class="pianificazione-pannello pan-form-card">
                    {% include 'ordini/_partials/_agenda_pianificazione.j2' %}
                </div>
            </section>
            <section class="col-12 col-lg-4" aria-labelledby="pianificazione-settings-title">
                <div class="pianificazione-pannello pianificazione-impostazioni pan-form-card">
                    <h6 id="pianificazione-settings-title" class="pianificazione-titolo">Impostazioni della produzione</h6>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="data-inizio-produzione">Data di inizio</label>
                        <input class="form-control" type="date" id="data-inizio-produzione"
                               name="data_inizio_produzione" required
                               hx-post="{{ url_for('ordini_cliente.simulazione_pianificazione') }}"
                               hx-trigger="change" hx-sync="#form-pianificazione:replace" hx-include="#form-pianificazione"
                               hx-target="#riepilogo-pianificazione" hx-swap="innerHTML">
                    </div>
                    <fieldset class="mb-3">
                        <legend class="form-label fw-semibold fs-6">Blocco iniziale</legend>
                        <div class="d-flex flex-wrap gap-3">
                            <label class="form-check-label"><input class="form-check-input me-1" type="radio" name="blocco_inizio_produzione" value="0" required
                                           hx-post="{{ url_for('ordini_cliente.simulazione_pianificazione') }}"
                                           hx-trigger="change" hx-sync="#form-pianificazione:replace" hx-include="#form-pianificazione"
                                           hx-target="#riepilogo-pianificazione" hx-swap="innerHTML"> Mattina</label>
                            <label class="form-check-label"><input class="form-check-input me-1" type="radio" name="blocco_inizio_produzione" value="1"
                                           hx-post="{{ url_for('ordini_cliente.simulazione_pianificazione') }}"
                                           hx-trigger="change" hx-sync="#form-pianificazione:replace" hx-include="#form-pianificazione"
                                           hx-target="#riepilogo-pianificazione" hx-swap="innerHTML"> Pomeriggio</label>
                        </div>
                    </fieldset>
                    <fieldset class="mb-3">
                        <legend class="form-label fw-semibold fs-6">Impastatrici disponibili</legend>
                        <p class="small text-secondary mb-2">Seleziona le macchine candidate. Il programma distribuirà automaticamente il peso effettivo e prenoterà solo le macchine necessarie.</p>
                        {% include 'ordini/_partials/_impastatrici_disponibili.j2' %}
                    </fieldset>
                    <div class="border rounded-3 p-3 bg-white mb-3">
                        <label class="form-label fw-semibold" for="quantita-da-stock">Preleva panettoni già a stock</label>
                        <div class="small text-secondary mb-2">Articolo: {{ riepilogo.codart_ordine }} · disponibili: <strong>{{ stock_disponibile }}</strong> pezzi.</div>
                        <input id="quantita-da-stock" class="form-control" type="number" min="0"
                               max="{{ [stock_disponibile, riepilogo.qta_panettoni - 1]|min }}" step="1"
                               value="0" name="quantita_da_stock" required
                               hx-post="{{ url_for('ordini_cliente.simulazione_pianificazione') }}"
                               hx-trigger="change, keyup changed delay:450ms"
                               hx-sync="#form-pianificazione:replace" hx-include="#form-pianificazione"
                               hx-target="#riepilogo-pianificazione" hx-swap="innerHTML">
                        <small class="text-secondary">Lo stock riduce i pezzi da produrre. Il rimanente viene pianificato con i coefficienti di peso.</small>
                    </div>
                    <div class="border rounded-3 p-3 bg-white">
                        <label class="form-check-label d-flex align-items-start gap-2" for="ottimizza-infornate">
                            <input id="ottimizza-infornate" type="checkbox" class="form-check-input mt-1 flex-shrink-0"
                                   name="ottimizza_infornate" value="1"
                                   hx-post="{{ url_for('ordini_cliente.simulazione_pianificazione') }}"
                                   hx-trigger="change"
                                   hx-sync="#form-pianificazione:replace" hx-include="#form-pianificazione"
                                   hx-target="#riepilogo-pianificazione"
                                   hx-swap="innerHTML"
                                   hx-indicator="#simulazione-attesa">
                            <span><strong>Ottimizza le cotte</strong>
                                <small class="text-secondary d-block">Completa l'ultima cotta. I pezzi in più saranno aggiunti allo stock soltanto dopo la conferma riuscita.</small></span>
                        </label>
                        <span class="small text-secondary htmx-indicator" id="simulazione-attesa">Ricalcolo in corso…</span>
                    </div>
                    <div class="alert alert-warning small mt-3 mb-0" role="note">
                        Il surplus sarà registrato nello stock alla conferma della pianificazione, anche se la produzione fisica non è ancora terminata. Gestire separatamente lo stock realmente disponibile.
                    </div>
                    {% for ordine in ordini_selezionati %}
                    <input type="hidden" name="ordini_selezionati" value="{{ ordine }}">
                    {% endfor %}
                </div>
            </section>
            <section class="col-12 col-lg-5" aria-labelledby="pianificazione-riepilogo-title">
                <div class="pianificazione-pannello pianificazione-riepilogo pan-form-card">
                    <h6 id="pianificazione-riepilogo-title" class="pianificazione-titolo">Ordini selezionati e simulazione</h6>
                    <div id="riepilogo-pianificazione" aria-live="polite">
                        {% include 'ordini/_partials/_anteprima_ottimizzazione.j2' %}
                    </div>
                </div>
            </section>
        </div>
    </div>
    <div class="modal-footer pan-modal-footer justify-content-between">
        <span class="small text-secondary">Le capacità e la disponibilità saranno nuovamente verificate al salvataggio.</span>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annulla</button>
            <button type="submit" form="form-pianificazione" class="btn btn-primary fw-bold px-4">Conferma pianificazione</button>
        </div>
    </div>
</form>
{% endif %}
