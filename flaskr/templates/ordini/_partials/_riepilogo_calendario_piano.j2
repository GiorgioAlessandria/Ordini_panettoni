<section class="pan-calendar-plan-summary">
  <div class="d-flex flex-wrap justify-content-between gap-3 mb-3">
    <div>
      <span class="badge bg-primary mb-2">Produzione #{{ piano.IdPianificazione }}</span>
      <h4 class="h5 mb-1">{{ descrizione }}</h4>
      <p class="pan-meta mb-0">{{ piano.CodArt }} · {{ piano.DataProduzione.strftime('%d/%m/%Y') }} · Blocco {{ piano.BloccoIniziale }}</p>
    </div>
    <div class="pan-compact-stats">
      <div><strong>{{ piano.PanettoniPianificati }}</strong><span>Pezzi da produrre</span></div>
      <div><strong>{{ piano.NumeroCotte }}</strong><span>Cotte</span></div>
      <div><strong>{{ '%.2f'|format(piano.PesoTotale|float / 1000) }}</strong><span>Kg impasto</span></div>
    </div>
  </div>
  <div class="row g-2 mb-3">
    <div class="col-6 col-md-4"><div class="pan-kpi h-100"><span class="pan-kpi-label">Ordini impegnati</span><strong class="pan-kpi-value">{{ totale_assegnato }}</strong></div></div>
    <div class="col-6 col-md-4"><div class="pan-kpi h-100"><span class="pan-kpi-label">Prelievo stock</span><strong class="pan-kpi-value">{{ totale_da_stock }}</strong></div></div>
    <div class="col-12 col-md-4"><div class="pan-kpi h-100"><span class="pan-kpi-label">Macchine</span><strong class="pan-kpi-value">{{ macchine|length }}</strong></div></div>
  </div>
  <section class="pan-panel mb-3">
    <header class="pan-panel-header"><h3>Ordini associati</h3></header>
    <div class="pan-table-wrap">
      <table class="table table-striped table-hover align-middle pan-table pan-responsive-records">
        <thead><tr><th>Ordine</th><th>Cliente</th><th>Consegna</th><th>Quantità impegnata</th><th>Da stock</th><th>Da produrre</th><th>Stato</th></tr></thead>
        <tbody>
          {% for a, o in associazioni %}
          <tr><td data-label="Ordine">{{ a.IdDocumento }}-{{ a.IdRiga }}</td><td data-label="Cliente">{{ o.Cliente.RagioneSociale }}</td><td data-label="Consegna">{{ o.DataConsegna.strftime('%d/%m/%Y') }}</td><td data-label="Quantità impegnata">{{ a.QtaPianificata }}</td><td data-label="Da stock">{{ a.QtaDaStock or 0 }}</td><td data-label="Da produrre">{{ a.QtaPianificata - (a.QtaDaStock or 0) }}</td><td data-label="Stato">{{ a.Stato }}</td></tr>
          {% else %}<tr><td colspan="7">Nessun ordine associato.</td></tr>{% endfor %}
        </tbody>
      </table>
    </div>
  </section>
  <section class="pan-panel mb-3">
    <header class="pan-panel-header"><h3>Fasi della pianificazione</h3></header>
    <div class="pan-table-wrap">
      <table class="table table-striped table-hover align-middle pan-table pan-responsive-records">
        <thead><tr><th>Giorno</th><th>Blocco</th><th>Lavorazione</th></tr></thead>
        <tbody>{% for fase, lavorazione in fasi %}<tr><td data-label="Giorno">{{ fase.DataFase.strftime('%d/%m/%Y') }}</td><td data-label="Blocco">{{ fase.Blocco }}</td><td data-label="Lavorazione">{{ lavorazione.DescrizioneLavorazione }}</td></tr>{% else %}<tr><td colspan="3">Nessuna fase.</td></tr>{% endfor %}</tbody>
      </table>
    </div>
  </section>
  {% if macchine %}<p class="small pan-meta mb-0"><strong>Impastatrici:</strong> {% for m in macchine %}{{ m.DescrizioneImpastatrice or m.ModelloImpastatrice }}{% if not loop.last %}, {% endif %}{% endfor %}</p>{% endif %}
  <footer class="d-flex align-items-center gap-2 border-top mt-3 pt-3 flex-wrap">
    <span class="badge {{ 'bg-success' if piano.StatoRigaOrdine == 'Chiuso' else ('bg-secondary' if piano.StatoRigaOrdine == 'Annullato' else 'bg-primary') }}">{{ piano.StatoRigaOrdine }}</span>
    <a class="btn btn-outline-primary btn-sm" href="{{ url_for('ordini_cliente.gestione_pianificazione', IdPianificazione=piano.IdPianificazione) }}">Gestione e dettagli pianificazione</a>
  </footer>
</section>
