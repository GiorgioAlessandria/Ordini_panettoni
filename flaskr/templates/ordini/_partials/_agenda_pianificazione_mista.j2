{# La simulazione HTMX aggiorna questo contenitore tramite hx-swap-oob. #}
<h6 class="pianificazione-titolo mb-2">Giornate della produzione</h6>
{% if agenda_mista is defined and agenda_mista %}
  <div class="d-flex flex-wrap align-items-center gap-2 small mb-2" aria-label="Legenda delle pianificazioni">
    <span class="pan-agenda-legend-draft">Da pianificare</span>
  </div>
  <p class="small text-secondary mb-2">Fasi dell'impasto condiviso e cottura unica con elenco dei forni interessati.</p>
  <div class="pan-agenda-scroll" role="region" aria-label="Giornate coinvolte dalla pianificazione mista" tabindex="0">
    {% for giorno, eventi in agenda_mista|groupby('data') %}
      <div class="pan-agenda-day {% if loop.first %}pan-agenda-day-selected{% endif %}">
        <div class="d-flex justify-content-between align-items-center mb-1">
          <strong class="small">{{ giorno.strftime('%d/%m/%Y') }}</strong>
          {% if loop.first %}<span class="badge bg-primary">Inizio</span>{% endif %}
        </div>
        {% for blocco in ['M', 'P'] %}
          <div class="pan-agenda-slot">
            <span class="pan-agenda-slot-marker">{{ blocco }}</span>
            <div class="flex-grow-1 min-width-0">
              {% set slot_eventi = eventi|selectattr('blocco', 'equalto', blocco)|list %}
              {% for evento in slot_eventi %}
                <div class="pan-agenda-event pan-agenda-proposta" role="note">
                  <strong>Da pianificare</strong> · {{ 'Cottura' if evento.tipo == 'cottura' else 'Impasto condiviso' }}
                  {% if evento.tipo == 'cottura' %}
                    <small class="d-block">{{ evento.forni|length }} forni coinvolti</small>
                    {% for f in evento.forni %}
                      <small class="d-block">{{ nomi_forni.get(f.id_forno, 'Forno #' ~ f.id_forno) }} · {{ f.cotte }} cotte · {{ f.data.strftime('%d/%m/%Y') }} {{ f.blocco }}</small>
                    {% endfor %}
                  {% else %}
                    <small class="d-block">Lavorazione {{ evento.lavorazione }}</small>
                  {% endif %}
                </div>
              {% else %}
                <span class="text-secondary small">Nessun evento</span>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      </div>
    {% endfor %}
  </div>
  <p class="small text-secondary mt-2 mb-0">Le fasi tratteggiate in arancione sono provvisorie. Le risorse vengono prenotate soltanto alla conferma.</p>
{% else %}
  <div class="text-secondary small py-3 text-center" role="status">Seleziona data, forni, cotte e impastatrici, quindi premi «Verifica disponibilità e simula».</div>
{% endif %}
