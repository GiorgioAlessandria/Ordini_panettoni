{# Vista riservata a vendite: ogni record e' una riga d'ordine ERP. #}
{% set prezzature = ordini_cliente | map(attribute='Prezzatura') | reject('none') | unique | sort | list %}
{% set note_per_ordine = note_vendite_per_righe(ordini_cliente, true) %}
{% set note_produzione_per_ordine = note_produzione_per_righe(ordini_cliente, true) %}
{% set commenti_etichetta_per_ordine = commenti_etichette_per_righe(ordini_cliente, true) %}
{% macro colonna(key, nome, tipo='text') %}
<th scope="col" aria-sort="none" data-sort-column="{{ key }}" data-col="{{ key }}">
    <button type="button" class="ordini-sort" data-sort-key="{{ key }}" data-sort-type="{{ tipo }}"
            aria-label="Ordina per {{ nome }}">{{ nome }} <span class="ordini-sort-indicator" aria-hidden="true">↕</span></button>
</th>
{% endmacro %}
<div id="form-ordini-vendite" class="ordini-form pan-orders-form" data-tipo-tabella="vendite">
    <div class="ordini-filtri pan-toolbar" role="group" aria-label="Filtri ordini clienti">
        <div class="ordini-filtro ricerca">
            <label for="filtro-vendite-ricerca">Ricerca</label>
            <input id="filtro-vendite-ricerca" class="form-control form-control-sm" type="search"
                   data-filter="ricerca" placeholder="Cliente, articolo, ordine..." autocomplete="off">
        </div>
        <div class="ordini-filtro">
            <label for="filtro-vendite-prezzatura">Prezzatura</label>
            <select id="filtro-vendite-prezzatura" class="form-select form-select-sm" data-filter="prezzatura">
                <option value="">Tutte</option>
                {% for valore in prezzature %}<option value="{{ valore }}">{{ valore }} g</option>{% endfor %}
            </select>
        </div>
        <div class="ordini-filtro">
            <label for="filtro-vendite-glassa">Glassa</label>
            <select id="filtro-vendite-glassa" class="form-select form-select-sm" data-filter="glassa">
                <option value="">Tutte</option><option value="Si">Sì</option><option value="No">No</option>
            </select>
        </div>
        <div class="ordini-filtro">
            <label for="filtro-vendite-dal">Consegna dal</label>
            <input id="filtro-vendite-dal" class="form-control form-control-sm" type="date" data-filter="dal">
        </div>
        <div class="ordini-filtro">
            <label for="filtro-vendite-al">Consegna al</label>
            <input id="filtro-vendite-al" class="form-control form-control-sm" type="date" data-filter="al">
        </div>
        <button type="button" class="btn btn-outline-secondary btn-sm ordini-reset" data-reset-filters>Azzera filtri</button>
    </div>
    <div class="ordini-barra pan-meta"><span data-contatore-righe>{{ ordini_cliente|length }} ordini</span></div>
    <div class="ordini-table-scroll pan-orders-table-wrap" tabindex="0" role="region"
         aria-label="Tutti gli ordini clienti, senza raggruppamenti">
        <table class="table table-striped table-hover align-middle ordini-table pan-table">
            <thead><tr>
                {{ colonna('ordine', 'Ordine') }}
                {{ colonna('cliente', 'Cliente') }}
                {{ colonna('articolo', 'Codice panettone') }}
                {{ colonna('descrizione', 'Descrizione') }}
                {{ colonna('consegna', 'Consegna', 'date') }}
                {{ colonna('ordinata', 'Q.tà ordinata', 'number') }}
                {{ colonna('quantita', 'Q.tà residua', 'number') }}
                {{ colonna('presa', 'Presa in carico', 'number') }}
                {{ colonna('prezzatura', 'Prezzatura', 'number') }}
                {{ colonna('glassa', 'Glassa') }}
                {{ colonna('stato', 'Stato') }}
                <th scope="col" data-col="commenti">Commenti vendite</th>
                <th scope="col" data-col="commenti_produzione">Commenti produzione</th>
                <th scope="col" data-col="commenti_etichetta">Commento etichetta</th>
            </tr></thead>
            <tbody>
            {% for ordine in ordini_cliente %}
            <tr data-record class="ordini-vendite-riga ordini-vendite-riga--{{ ordine.ClasseStato }}"
                data-original-index="{{ loop.index0 }}"
                data-commenti-ordini="{{ ordine.IdDocumento }}:{{ ordine.IdRigaDoc }}"
                data-id-documento="{{ ordine.IdDocumento }}" data-id-riga="{{ ordine.IdRigaDoc }}"
                data-filter-text="{{ ordine.Cliente }} {{ ordine.CodArt }} {{ ordine.DesArt }} {{ ordine.IdDocumento }}-{{ ordine.IdRigaDoc }} {{ ordine.Stato }}"
                data-filter-prezzatura="{{ ordine.Prezzatura or '' }}"
                data-filter-glassa="{{ ordine.Glassatura }}"
                data-filter-consegna="{{ ordine.DataConsegnaISO }}"
                hx-get="{{ url_for('ordini_cliente.dettaglio_ordine', IdDocumento=ordine.IdDocumento, IdRigaDoc=ordine.IdRigaDoc) }}"
                hx-trigger="click" hx-target="#htmx-global" hx-swap="innerHTML"
                tabindex="0" aria-label="Dettaglio ordine {{ ordine.IdDocumento }}-{{ ordine.IdRigaDoc }}">
                <td data-col="ordine" data-sort-value="{{ ordine.IdDocumento }}-{{ ordine.IdRigaDoc }}" class="text-nowrap fw-semibold">{{ ordine.IdDocumento }}-{{ ordine.IdRigaDoc }}</td>
                <td data-col="cliente">{{ ordine.Cliente }}</td>
                <td data-col="articolo">{{ ordine.CodArt }}</td>
                <td data-col="descrizione">{{ ordine.DesArt }}</td>
                <td data-col="consegna" data-sort-value="{{ ordine.DataConsegnaISO }}">{{ ordine.DataConsegna }}</td>
                <td data-col="ordinata" data-sort-value="{{ ordine.QTA_ORD }}" class="text-end">{{ ordine.QTA_ORD }}</td>
                <td data-col="quantita" data-sort-value="{{ ordine.QTA_Saldo }}" class="text-end">{{ ordine.QTA_Saldo }}</td>
                <td data-col="presa" data-sort-value="{{ ordine.QtaPresa }}" class="text-end">
                    {{ ordine.QtaPresa }}
                    {% if ordine.ClasseStato == 'parziale' %}
                    <div class="small text-secondary">{{ ordine.QtaDaPianificare }} da assegnare</div>
                    {% endif %}
                </td>
                <td data-col="prezzatura" data-sort-value="{{ ordine.Prezzatura or 0 }}">{{ ordine.Prezzatura or '—' }} g</td>
                <td data-col="glassa">{{ ordine.Glassatura }}</td>
                <td data-col="stato"><span class="ordini-vendite-stato ordini-vendite-stato--{{ ordine.ClasseStato }}">{{ ordine.Stato }}</span></td>
                <td data-col="commenti" class="pan-note-cell" onclick="event.stopPropagation()">
                    {% with id_documento=ordine.IdDocumento, id_riga=ordine.IdRigaDoc, note=note_per_ordine.get((ordine.IdDocumento, ordine.IdRigaDoc), []) %}
                        {% include 'ordini/_partials/_note_vendite_cella.j2' %}
                    {% endwith %}
                </td>
                <td data-col="commenti_produzione" class="pan-note-cell" onclick="event.stopPropagation()">
                    {% with id_documento=ordine.IdDocumento, id_riga=ordine.IdRigaDoc, note=note_produzione_per_ordine.get((ordine.IdDocumento, ordine.IdRigaDoc), []) %}
                        {% include 'ordini/_partials/_note_produzione_cella.j2' %}
                    {% endwith %}
                </td>
                <td data-col="commenti_etichetta" class="pan-note-cell" onclick="event.stopPropagation()">
                    {% set etichetta = commenti_etichetta_per_ordine.get((ordine.IdDocumento, ordine.IdRigaDoc)) %}
                    {% if etichetta and etichetta.testo %}
                    <div class="ordini-etichetta-lettura" role="note" aria-label="Commento etichetta {{ etichetta.tipo }}">
                        <span class="ordini-etichetta-tipo">C{{ etichetta.tipo }}</span>
                        <span class="ordini-etichetta-testo">{{ etichetta.testo }}</span>
                    </div>
                    {% else %}<span class="text-muted">—</span>{% endif %}
                </td>
            </tr>
            {% else %}
            <tr data-no-data><td colspan="14" class="text-center text-muted py-4">Nessun ordine disponibile.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
