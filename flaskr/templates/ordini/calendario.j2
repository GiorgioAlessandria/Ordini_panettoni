{% extends "base.j2" %}

{% block title %}Calendario produzione e scadenze{% endblock %}

{% block head %}
    {{ super() }}
    {# Gli stili devono essere inseriti in head: FullCalendar 7 li richiede separati. #}
    <link rel="stylesheet" href="{{ url_for('static', filename='vendor/fullcalendar-7.1.0/dist/skeleton.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', filename='vendor/fullcalendar-7.1.0/dist/themes/classic/theme.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', filename='vendor/fullcalendar-7.1.0/dist/themes/classic/palette.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/calendario.css', v='20261029-filtro-cottura-v1') }}">
{% endblock %}

{% block content %}
<section class="calendario-shell">
    <div class="calendario-riquadro" role="region" aria-label="Calendario settimanale" tabindex="0">
        {# Barra stabile: non viene ricreata da FullCalendar al cambio periodo/vista. #}
        <div class="calendario-toolbar" role="toolbar" aria-label="Navigazione, legenda e opzioni del calendario">
            <div class="calendario-toolbar-nav" role="group" aria-label="Navigazione calendario">
                <div class="calendario-toolbar-frecce">
                    <button type="button" class="calendario-toolbar-btn" id="calendar-prev" aria-label="Periodo precedente" title="Periodo precedente">&#8249;</button>
                    <button type="button" class="calendario-toolbar-btn" id="calendar-next" aria-label="Periodo successivo" title="Periodo successivo">&#8250;</button>
                </div>
                <button type="button" class="calendario-toolbar-btn calendario-toolbar-oggi" id="calendar-today">Oggi</button>
            </div>
            <div class="calendario-legenda" aria-label="Legenda del calendario">
                <span><i class="calendario-legenda-dot produzione" aria-hidden="true"></i> Produzioni · colori per piano</span>
                <span><i class="calendario-legenda-dot scadenza" aria-hidden="true"></i> Scadenze cliente · arancione</span>
                <span class="calendario-legenda-tipi">Fasi: colori da Impostazioni</span>
            </div>
            <h2 class="calendario-toolbar-titolo" id="calendar-current-title" aria-live="polite">Calendario</h2>
            <div class="calendario-controlli-weekend">
                <label class="calendario-weekend-toggle" for="calendar-show-weekends" title="Mostra anche sabato e domenica con sole scadenze">
                    <input id="calendar-show-weekends" type="checkbox" class="form-check-input">
                    <span>Mostra sabato e domenica</span>
                </label>
                <label class="calendario-weekend-toggle" for="calendar-hide-cottura" title="Nasconde le fasi di cottura dal calendario e dal PDF; nessuna pianificazione viene modificata">
                    <input id="calendar-hide-cottura" type="checkbox" class="form-check-input">
                    <span>Nascondi cottura</span>
                </label>
                <small class="calendario-weekend-status" id="calendar-weekend-status" role="status" aria-live="polite"></small>
            </div>
            <div class="calendario-toolbar-viste" role="group" aria-label="Seleziona la vista">
                <button type="button" class="calendario-toolbar-btn" data-calendar-view="timeGridWeek" aria-pressed="true" title="Settimana con ore">Ore</button>
                <button type="button" class="calendario-toolbar-btn" data-calendar-view="dayGridWeek" aria-pressed="false" title="Settimana a riquadri">Riquadri</button>
                <button type="button" class="calendario-toolbar-btn" data-calendar-view="dayGridMonth" aria-pressed="false">Mese</button>
                <button type="button" class="calendario-toolbar-btn" data-calendar-view="dayGridDay" aria-pressed="false">Giorno</button>
                <button type="button" class="calendario-toolbar-btn calendario-pdf-btn" id="calendar-pdf-export" title="Esporta tutte le fasi della settimana su un unico foglio PDF A3 orizzontale">PDF settimana</button>
            </div>
        </div>
        <div id="calendar"
             data-events-scadenze-url="{{ url_for('ordini_cliente.ordini_calendario_scadenze') }}"
             data-events-pianificazione-url="{{ url_for('ordini_cliente.eventi_fase_calendario') }}"
             data-export-pdf-url="{{ url_for('ordini_cliente.calendario_pdf_settimana') }}">
        </div>
    </div>
</section>
<div class="modal fade" id="modal-riepilogo-calendario" tabindex="-1" aria-labelledby="titolo-riepilogo-calendario" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title" id="titolo-riepilogo-calendario">Riepilogo ordine / pianificazione</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Chiudi"></button></div>
      <div class="modal-body" id="contenuto-riepilogo-calendario"><p>Caricamento...</p></div>
      <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Chiudi</button></div>
    </div>
  </div>
</div>

{% endblock %}

{% block scripts %}
    {{ super() }}
    {# base.j2 carica gia' fullcalendar.global.js e modal.js.
       Questo plugin registra il tema classic prima che il calendario venga creato. #}
    <script src="{{ url_for('static', filename='vendor/fullcalendar-7.1.0/dist/themes/classic/global.js') }}"></script>
    <script src="{{ url_for('static', filename='js/riepilogo_calendari.js', v='20261020-2') }}"></script>
    <script src="{{ url_for('static', filename='js/calendario.js', v='20261029-filtro-cottura-v1') }}"></script>
{% endblock %}
