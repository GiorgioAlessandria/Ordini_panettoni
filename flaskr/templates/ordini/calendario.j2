{% extends "base.j2" %}


{% block head %}
    {{ super() }}
    {# Gli stili devono essere inseriti in head: FullCalendar 7 li richiede separati. #}
    <link rel="stylesheet"
          href="{{ url_for('static', filename='vendor/fullcalendar-7.1.0/dist/skeleton.css') }}">
    <link rel="stylesheet"
          href="{{ url_for('static', filename='vendor/fullcalendar-7.1.0/dist/themes/classic/theme.css') }}">
    <link rel="stylesheet"
          href="{{ url_for('static', filename='vendor/fullcalendar-7.1.0/dist/themes/classic/palette.css') }}">
    <link rel="stylesheet"
          href="{{ url_for('static', filename='css/calendario.css', v='20261019-5') }}">
{% endblock %}

{% block content %}
    <section class="calendario-shell">
        <header class="calendario-intestazione">
            <a class="calendario-torna"
               href="{{ url_for('ordini_cliente.ordini_cliente') }}">
                &larr; Torna agli ordini
            </a>
        </header>

        <div class="calendario-legenda"
             aria-label="Legenda del calendario">
            <span><i class="calendario-legenda-dot produzione"
                     aria-hidden="true"></i> Produzioni · colore per pianificazione</span>
            <span><i class="calendario-legenda-dot scadenza"
                     aria-hidden="true"></i> Scadenze cliente · arancione</span>
            <span class="calendario-legenda-tipi">Tipologia: <b>Impasto</b> · <b>Cottura</b> · <b>Altre lavorazioni</b></span>
        </div>

        <div class="calendario-riquadro"
             role="region"
             aria-label="Calendario settimanale"
             tabindex="0">
            <div id="calendar"
                 data-events-scadenze-url="{{ url_for('ordini_cliente.ordini_calendario_scadenze') }}"
                 data-events-pianificazione-url="{{ url_for('ordini_cliente.eventi_fase_calendario') }}">
            </div>
        </div>
    </section>
{% endblock %}

{% block scripts %}
    {{ super() }}
    {# base.j2 carica gia' fullcalendar.global.js e modal.js.
       Questo plugin registra il tema classic prima che il calendario venga creato. #}
    <script src="{{ url_for('static', filename='vendor/fullcalendar-7.1.0/dist/themes/classic/global.js') }}"></script>
    <script src="{{ url_for('static', filename='js/calendario.js', v='20261019-5') }}"></script>
{% endblock %}
