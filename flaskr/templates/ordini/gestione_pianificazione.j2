{% extends "base.j2" %}
{% block title %}Gestione pianificazione #{{ piano.IdPianificazione }}{% endblock %}
{% block content %}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <div>
    <h1 class="h3 mb-1">Pianificazione #{{ piano.IdPianificazione }}</h1>
    <p class="text-secondary mb-0">{{ piano.CodArt }} · {{ piano.DataProduzione.strftime('%d/%m/%Y') }} · Blocco {{ piano.BloccoIniziale }}</p>
    {% set lotto_attuale = lotto_pianificazione("TRAD", piano.IdPianificazione) %}
    <div class="d-flex flex-wrap align-items-center gap-2 mt-2" aria-label="Lotto della pianificazione">
      <span class="small text-secondary fw-semibold">Lotto:</span>
      {% if lotto_attuale %}
      <span class="font-monospace fw-bold fs-5">{{ lotto_attuale }}</span>
      {% else %}
      <span class="text-secondary small">Non assegnato</span>
      {% endif %}
    </div>
  </div>
  <div class="d-flex gap-2 flex-wrap">
    <a class="btn btn-outline-dark" id="torna-pagina-precedente"
       href="{{ url_for('ordini_cliente.ordini_cliente') }}" aria-label="Torna alla pagina precedente">
      &larr; Torna indietro
    </a>
    <span class="badge {{ 'bg-success' if piano.StatoRigaOrdine == 'Chiuso' else 'bg-secondary' if piano.StatoRigaOrdine == 'Annullato' else 'bg-primary' }} p-2 align-self-center">{{ piano.StatoRigaOrdine }}</span>
    <a class="btn btn-outline-secondary" href="{{ url_for('ordini_cliente.ordini_cliente') }}">Ordini</a>
    <a class="btn btn-outline-primary" href="{{ url_for('ordini_cliente.pianificazioni_chiuse') }}">Storico</a>
  </div>
</div>
<div class="row g-3 mb-4">
  <div class="col-sm-3"><div class="border rounded p-3 h-100"><small class="text-secondary">Pezzi da produrre</small><div class="h4 mb-0">{{ piano.PanettoniPianificati }}</div></div></div>
  <div class="col-sm-3"><div class="border rounded p-3 h-100"><small class="text-secondary">Cotte</small><div class="h4 mb-0">{{ piano.NumeroCotte }}</div></div></div>
  <div class="col-sm-3"><div class="border rounded p-3 h-100"><small class="text-secondary">Peso impasto</small><div class="h4 mb-0">{{ '%.2f'|format(piano.PesoTotale|float / 1000) }} kg</div></div></div>
  <div class="col-sm-3"><div class="border rounded p-3 h-100"><small class="text-secondary">Prelievi / surplus stock</small><div class="h4 mb-0">{{ totale_da_stock }} / {{ piano.QtaStockGenerata if piano.QtaStockGenerata is not none else 'N/D' }} pz</div></div></div>
</div>
<section class="mb-4">
  <h2 class="h5">Ordini associati</h2>
  <div class="table-responsive border rounded" style="max-height:340px;overflow:auto">
    <table class="table table-striped align-middle mb-0">
      <thead class="table-light"><tr><th>Ordine</th><th>Cliente</th><th>Quantità impegnata</th><th>Da stock</th><th>Da produrre</th><th>Stato</th></tr></thead>
      <tbody>
      {% for a, o in associazioni %}<tr><td>{{ a.IdDocumento }}-{{ a.IdRiga }}</td><td>{{ o.Cliente.RagioneSociale }}</td><td>{{ a.QtaPianificata }}</td><td>{{ a.QtaDaStock or 0 }}</td><td>{{ a.QtaPianificata - (a.QtaDaStock or 0) }}</td><td>{{ a.Stato }}</td></tr>
      {% else %}<tr><td colspan="6">Nessun ordine associato</td></tr>{% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% if piano.StatoRigaOrdine == 'In produzione' and puo_ripianificare %}
<section class="card mb-4 border-primary" aria-labelledby="titolo-ripianificazione">
  <div class="card-body">
    <div class="d-flex flex-wrap gap-2 align-items-start justify-content-between mb-2">
      <div>
        <h2 class="h5 mb-1" id="titolo-ripianificazione">Ripianifica produzione</h2>
        <p class="text-secondary small mb-0">Come nella nuova pianificazione: scegli la data per visualizzare giornate, occupazioni e disponibilità. Impastatrici e assegnazioni sono in sola lettura.</p>
      </div>
      <span class="badge bg-primary">Piano #{{ piano.IdPianificazione }}</span>
    </div>
    <form id="form-ripianificazione" method="post"
          action="{{ url_for('ordini_cliente.conferma_ripianificazione', IdPianificazione=piano.IdPianificazione) }}">
      <input type="hidden" name="csrf_token" value="{{ csrf_ruoli() }}">
      <div class="row g-3 p-3 border rounded-3 bg-light mb-3 align-items-end">
        <div class="col-md-4">
          <label class="form-label fw-semibold" for="nuova-data-ripianificazione">Nuova data di inizio</label>
          <input class="form-control" id="nuova-data-ripianificazione" type="date"
                 name="nuova_data" required
                 hx-get="{{ url_for('ordini_cliente.anteprima_ripianificazione', IdPianificazione=piano.IdPianificazione) }}"
                 hx-trigger="change"
                 hx-target="#esito-ripianificazione" hx-swap="innerHTML"
                 hx-indicator="#ripianificazione-caricamento">
          <small class="text-secondary">Attuale: {{ piano.DataProduzione.strftime('%d/%m/%Y') }}</small>
        </div>
        <div class="col-md-3">
          <label class="form-label fw-semibold">Blocco iniziale (fisso)</label>
          <div class="form-control bg-white" aria-label="Blocco iniziale non modificabile">
            {{ 'Mattina (M)' if piano.BloccoIniziale == 'M' else 'Pomeriggio (P)' }}
            <span class="float-end text-secondary" aria-hidden="true">&#128274;</span>
          </div>
          <small class="text-secondary">Rimangono invariati anche gli offset.</small>
        </div>
        <div class="col-md-5">
          <label class="form-label fw-semibold" for="motivo-ripianificazione">Motivazione (obbligatoria)</label>
          <input class="form-control" id="motivo-ripianificazione"
                 name="motivo_ripianificazione" minlength="5" maxlength="500"
                 required placeholder="Es. posticipo della lavorazione">
          <small class="text-secondary">Sarà registrata nello storico del piano.</small>
        </div>
        <div class="col-12 d-flex flex-wrap align-items-center gap-2">
          <button class="btn btn-outline-primary btn-sm" type="button"
                  hx-get="{{ url_for('ordini_cliente.anteprima_ripianificazione', IdPianificazione=piano.IdPianificazione) }}"
                  hx-include="#nuova-data-ripianificazione"
                  hx-target="#esito-ripianificazione" hx-swap="innerHTML"
                  hx-indicator="#ripianificazione-caricamento">
            <span class="me-1" aria-hidden="true">&#8635;</span>Verifica disponibilità
          </button>
          <span id="ripianificazione-caricamento" class="htmx-indicator small text-secondary" role="status">Aggiornamento calendario e disponibilità…</span>
        </div>
      </div>
      <div id="lotto-ripianificazione-proposta" class="mb-3"
           hx-get="{{ url_for('ordini_cliente.proposta_lotto_pianificazione') }}?tipo=RIP&amp;id_piano={{ piano.IdPianificazione }}"
           hx-trigger="load, change from:#nuova-data-ripianificazione"
           hx-include="#nuova-data-ripianificazione" hx-swap="innerHTML">
        <div class="small text-secondary">Seleziona la nuova data per ottenere il nuovo lotto.</div>
      </div>
      <div id="esito-ripianificazione" aria-live="polite">
        <div class="border rounded-3 text-center p-4 text-secondary">
          Seleziona la nuova data: vedrai l'occupazione delle impastatrici e il calendario delle fasi e degli altri piani.
          La data non viene salvata finché non confermi.
        </div>
      </div>
    </form>
  </div>
</section>
{% endif %}
{% if piano.StatoRigaOrdine == 'In produzione' %}
<div class="row g-3">
  <div class="col-lg-6">
    <section class="card h-100"><div class="card-body">
      <h2 class="h5">Conferma completamento</h2>
      <p class="small text-secondary">Indica i pezzi effettivamente destinati a ogni ordine. Seconda scelta e magazzino sono quantità aggiuntive, non sottratte dagli ordini. Nessun limite rispetto al pianificato.</p>
      <form method="post" action="{{ url_for('ordini_cliente.conferma_chiusura_pianificazione', IdPianificazione=piano.IdPianificazione) }}" onsubmit="return confirm('Confermare consuntivo e chiusura definitiva della pianificazione #{{ piano.IdPianificazione }}?')">
        <input type="hidden" name="csrf_token" value="{{ csrf_ruoli() }}">
        {% for a, o in associazioni %}
        <div class="row align-items-center g-2 mb-2">
          <label class="col-sm-7 col-form-label" for="qprod-{{ a.IdDocumento }}-{{ a.IdRiga }}">Ordine {{ a.IdDocumento }}-{{ a.IdRiga }} · pianificati {{ a.QtaPianificata }} (da stock {{ a.QtaDaStock or 0 }})</label>
          <div class="col-sm-5"><input id="qprod-{{ a.IdDocumento }}-{{ a.IdRiga }}" class="form-control" type="number" name="prodotta_{{ a.IdDocumento }}_{{ a.IdRiga }}" value="{{ a.QtaPianificata - (a.QtaDaStock or 0) }}" min="0" step="1" required></div>
        </div>
        {% endfor %}
        <div class="row g-2 mb-3">
          <div class="col-sm-6"><label class="form-label">Seconda scelta · {{ piano.CodArt }}</label><input class="form-control" type="number" name="seconda_{{ piano.CodArt }}" value="0" min="0" step="1" required></div>
          <div class="col-sm-6"><label class="form-label">Prima scelta a magazzino · {{ piano.CodArt }}</label><input class="form-control" type="number" name="magazzino_{{ piano.CodArt }}" value="0" min="0" step="1" required></div>
        </div>
        {% if piano.QtaStockGenerata is none %}
          <div class="alert alert-warning small">Surplus storico non riconciliato: verificare lo stock prima della chiusura.</div>
        {% elif piano.QtaStockGenerata > 0 %}
          <div class="alert alert-info small">Questo piano ha già {{ piano.QtaStockGenerata }} pezzi anticipati a stock. Alla chiusura la giacenza sarà riconciliata con la quantità fisica dichiarata; se lo storno non è possibile, la chiusura verrà bloccata.</div>
        {% endif %}
        <button class="btn btn-success" type="submit" {% if piano.QtaStockGenerata is none %}disabled{% endif %}>Registra consuntivo e chiudi</button>
      </form>
    </div></section>
  </div>
  <div class="col-lg-6">
    <section class="card border-danger h-100"><div class="card-body">
      <h2 class="h5 text-danger">Annulla pianificazione</h2>
      <p>Libera le impastatrici, restituisce lo stock prelevato e storna il surplus accreditato. Non cancella lo storico.</p>
      {% set storico_bloccato = piano.QtaStockGenerata is none and surplus_teorico != 0 %}
      {% if piano.QtaStockGenerata is none %}
        {% if surplus_teorico == 0 %}
          <div class="alert alert-info">Pianificazione storica senza surplus fisico: l'annullamento è consentito e non stornerà pezzi aggiuntivi.</div>
        {% elif surplus_teorico is none %}
          <div class="alert alert-danger">Dati quantitativi incompleti: il surplus teorico non è calcolabile. Annullamento bloccato.</div>
        {% else %}
          <div class="alert alert-warning">
            <strong>Stock da riconciliare.</strong> Il surplus fisico teorico è di
            <strong>{{ surplus_teorico }} pezzi</strong>, ma non sappiamo quanti siano stati
            effettivamente accreditati nelle versioni precedenti. Il solo saldo attuale
            dello stock non dimostra la provenienza dei pezzi.
          </div>
          {% if puo_riconciliare %}
          <form method="post" action="{{ url_for('ordini_cliente.conferma_riconciliazione_stock', IdPianificazione=piano.IdPianificazione) }}" class="p-3 mb-3 border rounded bg-light">
            <h3 class="h6">Riconciliazione manuale dello stock</h3>
            <p class="small text-secondary">Riporta i pezzi che erano stati davvero accreditati alla creazione del piano (0 se nessuno). Questa operazione NON cambia la giacenza.</p>
            <label for="pezzi_stock_accreditati" class="form-label">Pezzi effettivamente accreditati (da 0 a {{ surplus_teorico }})</label>
            <input id="pezzi_stock_accreditati" name="pezzi_stock_accreditati" class="form-control mb-2" type="number" min="0" max="{{ surplus_teorico }}" step="1" required>
            <label for="motivo_riconciliazione" class="form-label">Fonte della verifica / motivazione</label>
            <textarea id="motivo_riconciliazione" name="motivo_riconciliazione" class="form-control mb-2" rows="2" minlength="10" required></textarea>
            <label class="d-flex align-items-start gap-2 mb-2">
              <input type="checkbox" name="conferma_verifica_stock" value="1" class="form-check-input mt-1" required>
              <span class="small">Confermo che il numero inserito corrisponde ai movimenti realmente eseguiti, non soltanto al surplus teorico.</span>
            </label>
            <button class="btn btn-outline-primary" type="submit">Registra riconciliazione</button>
          </form>
          {% else %}
            <div class="small text-secondary mb-3">Richiedi la riconciliazione a un operatore autorizzato prima di annullare.</div>
          {% endif %}
        {% endif %}
      {% endif %}
      <form method="post" action="{{ url_for('ordini_cliente.conferma_annullamento_pianificazione', IdPianificazione=piano.IdPianificazione) }}" onsubmit="return confirm('Annullare la pianificazione #{{ piano.IdPianificazione }}? I movimenti di stock verranno stornati.')">
        <label for="motivo_annullamento" class="form-label">Motivo obbligatorio</label>
        <textarea class="form-control mb-2" id="motivo_annullamento" name="motivo_annullamento" rows="2" minlength="5" maxlength="500" required></textarea>
        <button class="btn btn-danger" type="submit" {% if storico_bloccato %}disabled{% endif %}>Annulla e ripristina</button>
      </form>
    </div></section>
  </div>
</div>
{% else %}
<div class="alert alert-info">Questa pianificazione non è più in produzione: non è possibile eseguire nuovamente chiusura o annullamento.</div>
{% endif %}
{% if piano.StatoRigaOrdine == 'Chiuso' and consuntivo_ordini %}
<section class="card my-4"><div class="card-body">
  <h2 class="h5">Consuntivo effettivo</h2>
  {% for a, o in associazioni %}{% set cons = consuntivo_ordini.get((a.IdDocumento, a.IdRiga)) %}
  <div class="small border-bottom py-1">Ordine {{ a.IdDocumento }}-{{ a.IdRiga }} · pianificati {{ a.QtaPianificata }} · prodotti per ordine <strong>{{ cons.QtaProdotta if cons else '—' }}</strong></div>
  {% endfor %}
  {% set ca = consuntivo_articoli.get(piano.CodArt) %}
  {% if ca %}<p class="mt-3 mb-0">Articolo {{ piano.CodArt }} · Seconda scelta <strong>{{ ca.QtaSecondaScelta }}</strong> · Magazzino prima scelta <strong>{{ ca.QtaMagazzino }}</strong></p>{% endif %}
</div></section>
{% endif %}
{% if storico_spostamenti %}
<section class="mt-4">
  <h2 class="h5">Storico ripianificazioni</h2>
  <div class="table-responsive"><table class="table table-sm table-bordered align-middle">
    <thead><tr><th>Data operazione</th><th>Prima</th><th>Dopo</th><th>Operatore</th><th>Motivo</th></tr></thead>
    <tbody>{% for evento in storico_spostamenti %}
      <tr><td>{{ evento.DataOperazione.strftime('%d/%m/%Y %H:%M') }}</td>
      <td>{{ evento.DataPrecedente.strftime('%d/%m/%Y') }} · {{ evento.BloccoIniziale }}</td>
      <td>{{ evento.DataNuova.strftime('%d/%m/%Y') }} · {{ evento.BloccoIniziale }}</td>
      <td>{{ evento.Operatore }}</td><td>{{ evento.Motivo }}</td></tr>
    {% endfor %}</tbody>
  </table></div>
</section>
{% endif %}
{% if registro %}
<section class="mt-4"><h2 class="h5">Registro operazioni</h2><div class="table-responsive"><table class="table table-sm table-bordered"><thead><tr><th>Data</th><th>Evento</th><th>Operatore</th><th>Motivo</th><th>Stock restituito</th><th>Stock stornato</th></tr></thead><tbody>{% for e in registro %}<tr><td>{{ e.DataOperazione.strftime('%d/%m/%Y %H:%M') }}</td><td>{{ e.Azione }}</td><td>{{ e.Operatore }}</td><td>{{ e.Motivo or '—' }}</td><td>{{ e.StockRestituito }}</td><td>{{ e.StockStornato }}</td></tr>{% endfor %}</tbody></table></div></section>
{% endif %}
{% endblock %}

{% block scripts %}
  {{ super() }}
  <script>
    (function () {
      'use strict';
      const pulsante = document.getElementById('torna-pagina-precedente');
      if (!pulsante) return;
      pulsante.addEventListener('click', function (evento) {
        if (evento.button !== 0 || evento.ctrlKey || evento.metaKey || evento.shiftKey || evento.altKey) return;
        // Se la navigazione proviene da un'altra pagina dell'applicazione,
        // torna lì preservando la cronologia (e, dove disponibile, il calendario).
        // Su accesso diretto, link esterno o pagina attuale: usa il fallback Ordini.
        let precedente;
        try { precedente = new URL(document.referrer); } catch (_) { return; }
        if (precedente.origin !== window.location.origin) return;
        if (precedente.href === window.location.href) return;
        if (window.history.length < 2) return;
        evento.preventDefault();
        window.history.back();
      });
    })();
  </script>
{% endblock %}
