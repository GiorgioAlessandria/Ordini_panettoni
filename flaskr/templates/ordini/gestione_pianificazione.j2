{% extends "base.j2" %}
{% block title %}Gestione pianificazione #{{ piano.IdPianificazione }}{% endblock %}
{% block content %}
<div class="pan-page pan-detail-page">

<div class="d-flex gap-2 align-items-center mb-2">
  <span class="badge {{ 'bg-success' if piano.StatoRigaOrdine == 'Chiuso' else 'bg-secondary' if piano.StatoRigaOrdine == 'Annullato' else 'bg-primary' }}">{{ piano.StatoRigaOrdine }}</span>
  <small class="text-secondary">{{ piano.CodArt }} · {{ piano.DataProduzione.strftime('%d/%m/%Y') }} · Blocco {{ piano.BloccoIniziale }}</small>
</div>
<div class="pan-kpi-grid">
  <div class="pan-kpi"><small class="pan-kpi-label">Pezzi da produrre</small><div class="pan-kpi-value">{{ piano.PanettoniPianificati }}</div></div>
  <div class="pan-kpi"><small class="pan-kpi-label">Cotte</small><div class="pan-kpi-value">{{ piano.NumeroCotte }}</div></div>
  <div class="pan-kpi"><small class="pan-kpi-label">Peso impasto</small><div class="pan-kpi-value">{{ '%.2f'|format(piano.PesoTotale|float / 1000) }} kg</div></div>
  <div class="pan-kpi"><small class="pan-kpi-label">Prelievi / surplus stock</small><div class="pan-kpi-value">{{ totale_da_stock }} / {{ piano.QtaStockGenerata if piano.QtaStockGenerata is not none else 'N/D' }} pz</div></div>
</div>
<section class="pan-panel mb-3">
  <div class="pan-panel-header"><h2 class="pan-section-title">Ordini associati</h2></div>
  <div class="table-responsive">
    <table class="table table-striped table-hover align-middle mb-0 pan-table pan-mobile-cards">
      <thead><tr><th>Ordine</th><th>Cliente</th><th>Quantità impegnata</th><th>Da stock</th><th>Da produrre</th><th>Stato</th></tr></thead>
      <tbody>
      {% for a, o in associazioni %}<tr><td data-label="Ordine">{{ a.IdDocumento }}-{{ a.IdRiga }}</td><td data-label="Cliente">{{ o.Cliente.RagioneSociale }}</td><td data-label="Quantità impegnata">{{ a.QtaPianificata }}</td><td data-label="Da stock">{{ a.QtaDaStock or 0 }}</td><td data-label="Da produrre">{{ a.QtaPianificata - (a.QtaDaStock or 0) }}</td><td data-label="Stato">{{ a.Stato }}</td></tr>
      {% else %}<tr><td colspan="6">Nessun ordine associato</td></tr>{% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% if piano.StatoRigaOrdine == 'In produzione' %}
<div class="row g-3">
  <div class="col-lg-6">
    <section class="card pan-panel h-100"><div class="card-body">
      <h2 class="h5">Conferma completamento</h2>
      <p>Chiude questa pianificazione e tutte le sue righe. Le quantità già impegnate restano contabilizzate; il surplus non viene accreditato nuovamente.</p>
      <form method="post" action="{{ url_for('ordini_cliente.conferma_chiusura_pianificazione', IdPianificazione=piano.IdPianificazione) }}" onsubmit="return confirm('Confermare la chiusura definitiva della pianificazione #{{ piano.IdPianificazione }}?')">
        <button class="btn btn-success" type="submit">Conferma chiusura</button>
      </form>
    </div></section>
  </div>
  <div class="col-lg-6">
    <section class="card pan-panel border-danger h-100"><div class="card-body">
      <h2 class="h5 text-danger">Annulla pianificazione</h2>
      <p>Libera le impastatrici, restituisce lo stock prelevato e storna il surplus accreditato. Non cancella lo storico.</p>
      {% set storico_bloccato = piano.QtaStockGenerata is none and surplus_teorico != 0 %}
      {% if piano.QtaStockGenerata is none %}
        {% if surplus_teorico == 0 %}
          <div class="alert alert-info">Pianificazione storica senza surplus fisico: l'annullamento è consentito e non stornerà pezzi aggiuntivi.</div>
        {% elif surplus_teorico is none %}
          <div class="alert alert-danger">Dati quantitativi incompleti: il surplus teorico non è calcolabile. Annullamento bloccato.</div>
        {% else %}
          <div class="alert alert-warning">
            <strong>Stock da riconciliare.</strong> Il surplus fisico teorico è di
            <strong>{{ surplus_teorico }} pezzi</strong>, ma non sappiamo quanti siano stati
            effettivamente accreditati nelle versioni precedenti. Il solo saldo attuale
            dello stock non dimostra la provenienza dei pezzi.
          </div>
          {% if puo_riconciliare %}
          <form method="post" action="{{ url_for('ordini_cliente.conferma_riconciliazione_stock', IdPianificazione=piano.IdPianificazione) }}" class="p-3 mb-3 border rounded bg-light">
            <h3 class="h6">Riconciliazione manuale dello stock</h3>
            <p class="small text-secondary">Riporta i pezzi che erano stati davvero accreditati alla creazione del piano (0 se nessuno). Questa operazione NON cambia la giacenza.</p>
            <label for="pezzi_stock_accreditati" class="form-label">Pezzi effettivamente accreditati (da 0 a {{ surplus_teorico }})</label>
            <input id="pezzi_stock_accreditati" name="pezzi_stock_accreditati" class="form-control mb-2" type="number" min="0" max="{{ surplus_teorico }}" step="1" required>
            <label for="motivo_riconciliazione" class="form-label">Fonte della verifica / motivazione</label>
            <textarea id="motivo_riconciliazione" name="motivo_riconciliazione" class="form-control mb-2" rows="2" minlength="10" required></textarea>
            <label class="d-flex align-items-start gap-2 mb-2">
              <input type="checkbox" name="conferma_verifica_stock" value="1" class="form-check-input mt-1" required>
              <span class="small">Confermo che il numero inserito corrisponde ai movimenti realmente eseguiti, non soltanto al surplus teorico.</span>
            </label>
            <button class="btn btn-outline-primary" type="submit">Registra riconciliazione</button>
          </form>
          {% else %}
            <div class="small text-secondary mb-3">Richiedi la riconciliazione a un operatore autorizzato prima di annullare.</div>
          {% endif %}
        {% endif %}
      {% endif %}
      <form method="post" action="{{ url_for('ordini_cliente.conferma_annullamento_pianificazione', IdPianificazione=piano.IdPianificazione) }}" onsubmit="return confirm('Annullare la pianificazione #{{ piano.IdPianificazione }}? I movimenti di stock verranno stornati.')">
        <label for="motivo_annullamento" class="form-label">Motivo obbligatorio</label>
        <textarea class="form-control mb-2" id="motivo_annullamento" name="motivo_annullamento" rows="2" minlength="5" maxlength="500" required></textarea>
        <button class="btn btn-danger" type="submit" {% if storico_bloccato %}disabled{% endif %}>Annulla e ripristina</button>
      </form>
    </div></section>
  </div>
</div>
{% else %}
<div class="alert alert-info">Questa pianificazione non è più in produzione: non è possibile eseguire nuovamente chiusura o annullamento.</div>
{% endif %}
{% if registro %}
<section class="pan-panel mt-3"><div class="pan-panel-header"><h2 class="pan-section-title">Registro operazioni</h2></div><div class="table-responsive"><table class="table table-sm table-bordered pan-table pan-mobile-cards"><thead><tr><th>Data</th><th>Evento</th><th>Operatore</th><th>Motivo</th><th>Stock restituito</th><th>Stock stornato</th></tr></thead><tbody>{% for e in registro %}<tr><td data-label="Data">{{ e.DataOperazione.strftime('%d/%m/%Y %H:%M') }}</td><td data-label="Evento">{{ e.Azione }}</td><td data-label="Operatore">{{ e.Operatore }}</td><td data-label="Motivo">{{ e.Motivo or '—' }}</td><td data-label="Stock restituito">{{ e.StockRestituito }}</td><td data-label="Stock stornato">{{ e.StockStornato }}</td></tr>{% endfor %}</tbody></table></div></section>
{% endif %}
</div>
{% endblock %}
