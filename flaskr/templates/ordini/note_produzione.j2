{% extends "base.j2" %}
{% block title %}Commento ordine {{ ordine.IdDocumento }}-{{ ordine.IdRigaDoc }}{% endblock %}
{% block content %}
<div class="mb-2"><a class="btn btn-outline-secondary btn-sm" href="{{ url_for('ordini_cliente.ordini_cliente') }}">← Torna agli ordini</a></div>
<section class="pan-page pan-notes-page pan-panel p-3" aria-label="Commento produzione">
    <div class="mb-2"><strong>Ordine {{ ordine.IdDocumento }}-{{ ordine.IdRigaDoc }}</strong>
        <span class="text-secondary">· {{ ordine.CodArt }} · {{ ordine.DesArt }}</span>
    </div>
    {% with id_documento=ordine.IdDocumento, id_riga=ordine.IdRigaDoc %}
        {% include 'ordini/_partials/_note_produzione_cella.j2' %}
    {% endwith %}
</section>
{% endblock %}
