{% extends 'base.j2' %}
{% block title %}Gestione spedizioni{% endblock %}
{% block content %}
<div class="container-fluid py-3">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
      <h1 class="h4 mb-1">Gestione spedizioni</h1>
      <div class="small text-secondary">Sono spedibili solo righe d'ordine in stato Chiuso. La partenza viene registrata separatamente dalla preparazione.</div>
    </div>
    {% if ruolo_corrente != 'utente_spedizioni' %}
    <a href="{{ url_for('ordini_cliente.ordini_cliente') }}" class="btn btn-outline-secondary btn-sm">Torna agli ordini</a>
    {% endif %}
  </div>
  <div class="row g-3 mb-3">
    <div class="col-sm-4"><div class="bg-white border rounded-3 p-3"><small class="text-secondary">Righe pronte</small><div class="fs-4 fw-semibold">{{ ordini_disponibili|length }}</div></div></div>
    <div class="col-sm-4"><div class="bg-white border rounded-3 p-3"><small class="text-secondary">Spedizioni preparate</small><div class="fs-4 fw-semibold">{{ preparate|length }}</div></div></div>
    <div class="col-sm-4"><div class="bg-white border rounded-3 p-3"><small class="text-secondary">Spedizioni partite</small><div class="fs-4 fw-semibold">{{ spedite|length }}</div></div></div>
  </div>

  {# Recupero commenti batch, non includiamo le celle con form e bottoni di modifica. #}
  {% set note_vendite = note_vendite_per_righe(ordini_disponibili, true) %}
  {% set note_produzione = note_produzione_per_righe(ordini_disponibili, true) %}
  {% macro commenti_sola_lettura(note) %}
    {% for nota in note %}
      <div class="small border-bottom py-1">
        <span class="fw-semibold">{{ nota.AutoreNome }}</span>:
        <span style="white-space: pre-wrap;">{{ nota.Testo }}</span>
      </div>
    {% else %}<span class="text-muted">—</span>{% endfor %}
  {% endmacro %}
  <section id="da-spedire" class="bg-white border rounded-3 shadow-sm p-3 mb-4">
    <h2 class="h5">1. Da spedire</h2>
    <p class="text-secondary small">Seleziona una o più righe dello stesso cliente. Le spedizioni parziali non sono previste. Le righe senza quantità effettiva verificata sono visibili ma non selezionabili.</p>
    <form action="{{ url_for('ordini_cliente.spedizioni_prepara') }}" method="post">
      <input type="hidden" name="csrf_token" value="{{ csrf_ruoli() }}">
      <div class="table-responsive" style="max-height: 52vh; overflow-y:auto;">
        <table class="table table-striped table-hover table-sm align-middle">
          <thead class="table-light" style="position: sticky;top:0;"><tr><th scope="col">Seleziona</th><th scope="col">Ordine</th><th scope="col">Cliente</th><th scope="col">Articolo</th><th scope="col">Descrizione</th><th scope="col" class="text-end">Pezzi da spedire</th><th scope="col" class="text-end">Pezzi assegnati</th><th scope="col">Lotto/i</th><th scope="col">Consegna</th><th scope="col">Commenti vendite (lettura)</th><th scope="col">Commenti produzione (lettura)</th></tr></thead>
          <tbody>
          {% for ordine in ordini_disponibili %}
            <tr>
              <td>{% if ordine.ConsuntivoMancante %}
              <span class="badge text-bg-warning">Da verificare</span>
              {% else %}
              <input type="checkbox" class="form-check-input" name="ordini" value="{{ ordine.IdDocumento }}-{{ ordine.IdRigaDoc }}" aria-label="Seleziona ordine {{ ordine.IdDocumento }}-{{ ordine.IdRigaDoc }}">
              {% endif %}</td>
              <td class="text-nowrap fw-semibold">{{ ordine.IdDocumento }}-{{ ordine.IdRigaDoc }}</td>
              <td>{{ ordine.Cliente.RagioneSociale if ordine.Cliente else ordine.CodCliFor }}</td>
              <td>{{ ordine.CodArt }}</td><td>{{ ordine.DesArt }}</td>
              <td class="text-end">{{ ordine.QtaAssegnataSpedizione if not ordine.ConsuntivoMancante else "—" }}</td>
              <td class="text-end">{{ ordine.QtaAssegnataSpedizione if not ordine.ConsuntivoMancante else "Da verificare" }}</td>
              <td>{{ ordine.LottiSpedizione | join(', ') if ordine.LottiSpedizione else '—' }}</td>
              <td>{{ ordine.DataConsegna.strftime('%d-%m-%Y') if ordine.DataConsegna else '—' }}</td>
              <td>{{ commenti_sola_lettura(note_vendite.get((ordine.IdDocumento, ordine.IdRigaDoc), [])) }}</td>
              <td>{{ commenti_sola_lettura(note_produzione.get((ordine.IdDocumento, ordine.IdRigaDoc), [])) }}</td>
            </tr>
          {% else %}
            <tr><td colspan="11" class="text-center text-secondary py-4">Nessun ordine in stato Chiuso disponibile per la spedizione.</td></tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
      <div class="row g-2 mt-2 align-items-end">
        <div class="col-sm-3"><label class="form-label" for="data-prevista">Data prevista</label><input id="data-prevista" type="date" class="form-control" name="data_prevista"></div>
        <div class="col-sm-6"><label class="form-label" for="note-spedizione">Note di spedizione</label><input id="note-spedizione" type="text" maxlength="600" class="form-control" name="note" placeholder="Riferimento trasporto, istruzioni..."></div>
        <div class="col-sm-3 d-grid"><button type="submit" class="btn btn-primary">Prepara spedizione</button></div>
      </div>
    </form>
  </section>

  <section id="preparate" class="bg-white border rounded-3 shadow-sm p-3 mb-4">
    <h2 class="h5">2. Spedizioni preparate</h2>
    {% for spedizione in preparate %}
    <div class="border rounded-3 p-3 mb-2">
      <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
        <div><strong>Spedizione #{{ spedizione.IdSpedizione }}</strong> · {{ spedizione.ClienteSnapshot }}
          <div class="small text-secondary">Creata {{ spedizione.DataCreazione.strftime('%d-%m-%Y %H:%M') }} da {{ spedizione.OperatoreCreazione }}{% if spedizione.DataPrevista %} · Prevista {{ spedizione.DataPrevista.strftime('%d-%m-%Y') }}{% endif %}</div>
          {% if spedizione.Note %}<div class="small">{{ spedizione.Note }}</div>{% endif %}
        </div>
        <span class="badge bg-warning text-dark">Preparata</span>
      </div>
      <div class="small mb-2">
        {% for r in spedizione.righe %}<span class="d-inline-block border rounded px-2 py-1 me-1 mb-1">{{ r.IdDocumento }}-{{ r.IdRigaDoc }} · {{ r.CodArtSnapshot }} · <strong>{{ r.Quantita }} pz</strong> · Assegnati {{ r.QtaAssegnata }} · Lotti {{ r.LottiSnapshot or '—' }}</span>{% endfor %}
      </div>
      <div class="d-flex flex-wrap gap-2 align-items-end">
        <form method="post" action="{{ url_for('ordini_cliente.spedizioni_partenza', id_spedizione=spedizione.IdSpedizione) }}" class="d-flex flex-wrap align-items-end gap-2">
          <input type="hidden" name="csrf_token" value="{{ csrf_ruoli() }}">
          <div><label class="form-label small" for="partenza-{{ spedizione.IdSpedizione }}">Data e ora partenza</label><input id="partenza-{{ spedizione.IdSpedizione }}" class="form-control form-control-sm" type="datetime-local" name="data_partenza" required></div>
          <button type="submit" class="btn btn-success btn-sm">Conferma partenza</button>
        </form>
        <form method="post" action="{{ url_for('ordini_cliente.spedizioni_annulla', id_spedizione=spedizione.IdSpedizione) }}" class="ms-sm-auto">
          <input type="hidden" name="csrf_token" value="{{ csrf_ruoli() }}">
          <button type="submit" class="btn btn-outline-danger btn-sm">Annulla preparazione</button>
        </form>
      </div>
    </div>
    {% else %}<p class="text-secondary small">Nessuna spedizione preparata.</p>{% endfor %}
  </section>

  <section id="storico" class="bg-white border rounded-3 shadow-sm p-3 mb-4">
    <h2 class="h5">3. Storico partenze</h2>
    <div class="table-responsive"><table class="table table-sm table-striped align-middle">
      <thead><tr><th>Spedizione</th><th>Cliente</th><th>Ordini</th><th>Pezzi</th><th>Lotti</th><th>Partenza</th><th>Operatore</th></tr></thead>
      <tbody>{% for s in spedite %}
      <tr><td>#{{ s.IdSpedizione }}</td><td>{{ s.ClienteSnapshot }}</td>
        <td>{% for r in s.righe %}{{ r.IdDocumento }}-{{ r.IdRigaDoc }}{% if not loop.last %}, {% endif %}{% endfor %}</td>
        <td>{{ s.righe | sum(attribute='Quantita') }}</td>
        <td>{% for r in s.righe %}{{ r.LottiSnapshot or '—' }}{% if not loop.last %}; {% endif %}{% endfor %}</td>
        <td>{{ s.DataPartenza.strftime('%d-%m-%Y %H:%M') if s.DataPartenza else '—' }}</td><td>{{ s.OperatorePartenza or '—' }}</td></tr>
      {% else %}<tr><td colspan="7" class="text-center text-secondary py-4">Nessuna partenza registrata.</td></tr>{% endfor %}
      </tbody>
    </table></div>
  </section>
</div>
{% endblock %}
