{% extends 'base.j2' %}

{% block title %}<title>Impostazioni produzione</title>{% endblock %}

{% block head %}
    {{ super() }}
    <link rel="stylesheet" href="{{ url_for('static', filename='css/impostazioni.css', v='20261020-1') }}">
{% endblock %}

{% block content %}
<div class="settings-wrapper">
    <header class="settings-top mb-3">
        <div>
            <a class="settings-back" href="{{ url_for('ordini_cliente.ordini_cliente') }}">← Torna agli ordini</a>
            <h1 class="h3 mt-2 mb-1">Impostazioni produzione</h1>
            <p class="text-muted mb-0">Gestisci anagrafiche, parametri e collegamenti senza intervenire nel database.</p>
        </div>
        <div class="settings-readonly-note">
            <strong>Dati ERP protetti</strong>
            <span>Articoli, clienti e ordini non vengono modificati da questa pagina.</span>
        </div>
    </header>

    {% if errore %}<div class="alert alert-danger">{{ errore }}</div>{% endif %}

    <div class="settings-layout">
        <nav class="settings-sidebar card" aria-label="Sezioni impostazioni">
            <div class="card-body">
                {% for gruppo in gruppi %}
                    <h2 class="settings-group-title">{{ gruppo }}</h2>
                    {% for slug, item in sezioni.items() %}
                        {% if item.gruppo == gruppo %}
                            <a class="settings-nav-link {{ 'is-active' if spec.slug == slug else '' }}"
                               href="{{ url_for('ordini_cliente.impostazioni_pagina', sezione=slug) }}"
                               {% if spec.slug == slug %}aria-current="page"{% endif %}>
                                <span>{{ item.titolo }}</span>
                                <span class="settings-counter">{{ statistiche[slug] }}</span>
                            </a>
                        {% endif %}
                    {% endfor %}
                {% endfor %}
            </div>
        </nav>

        <div class="settings-main">
            <section class="card settings-panel">
                <div class="card-header settings-panel-header">
                    <div>
                        <h2 class="h5 mb-1">{{ spec.titolo }}</h2>
                        <p class="text-muted mb-0 small">{{ spec.descrizione }}</p>
                    </div>
                    <a class="btn btn-primary btn-sm" href="{{ url_for('ordini_cliente.impostazioni_pagina', sezione=spec.slug) }}">+ Nuovo</a>
                </div>
                <div class="card-body">
                    <form method="get" action="{{ url_for('ordini_cliente.impostazioni_pagina', sezione=spec.slug) }}" class="settings-search mb-3">
                        <label class="visually-hidden" for="settings-search">Cerca</label>
                        <input class="form-control" id="settings-search" type="search" name="q" value="{{ q }}" placeholder="Cerca per codice, nome o valore...">
                        <button class="btn btn-outline-primary" type="submit">Cerca</button>
                        {% if q %}<a class="btn btn-outline-secondary" href="{{ url_for('ordini_cliente.impostazioni_pagina', sezione=spec.slug) }}">Cancella</a>{% endif %}
                    </form>

                    {% if righe %}
                        <div class="settings-results">
                            {% for record in righe %}
                                <div class="settings-record">
                                    <div class="settings-record-info">
                                        <div class="settings-record-title">
                                            {% for campo in spec.campi[:2] %}
                                                {% set valore = record|attr(campo.nome) %}
                                                {% if campo.tipo == 'fk' %}
                                                    {{ etichette_fk[campo.nome].get(valore|string, valore) }}
                                                {% else %}
                                                    {{ valore }}
                                                {% endif %}
                                                {% if not loop.last %}<span class="text-muted"> · </span>{% endif %}
                                            {% endfor %}
                                        </div>
                                        <div class="settings-record-details">
                                            {% for campo in spec.campi[2:] %}
                                                {% set valore = record|attr(campo.nome) %}
                                                <span><strong>{{ campo.etichetta }}:</strong>
                                                    {% if campo.tipo == 'fk' %}{{ etichette_fk[campo.nome].get(valore|string, valore) }}
                                                    {% elif campo.tipo == 'select' %}
                                                        {% set ns = namespace(etichetta=valore|string) %}
                                                        {% for codice, nome in campo.scelte %}{% if codice == valore|string %}{% set ns.etichetta = nome %}{% endif %}{% endfor %}
                                                        {{ ns.etichetta }}
                                                    {% else %}{{ valore }}{% endif %}
                                                </span>
                                            {% endfor %}
                                        </div>
                                    </div>
                                    <div class="settings-record-actions">
                                        {% if spec.slug not in ['articoli-ricette', 'forni-lavorazioni'] %}
                                            <a class="btn btn-sm btn-outline-primary"
                                               href="{{ url_for('ordini_cliente.impostazioni_pagina', sezione=spec.slug, modifica=codifica_pk(spec, record), q=q, pagina=pagina) }}">Modifica</a>
                                        {% endif %}
                                        {% if spec.slug == 'ricette' %}
                                            <a class="btn btn-sm btn-outline-secondary" href="{{ url_for('ordini_cliente.impostazioni_pagina', sezione='fasi', IdRicetta=record.IdRicetta) }}">+ Fase</a>
                                        {% endif %}
                                        {% if spec.consentire_eliminazione %}
                                            <form method="post" action="{{ url_for('ordini_cliente.impostazioni_elimina', sezione=spec.slug) }}"
                                                  onsubmit="return confirm('Eliminare la voce selezionata? Non è possibile annullare questa operazione.');">
                                                <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
                                                <input type="hidden" name="_record_token" value="{{ codifica_pk(spec, record) }}">
                                                <button class="btn btn-sm btn-outline-danger" type="submit">Rimuovi</button>
                                            </form>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="text-muted settings-empty">Nessun elemento trovato. Puoi aggiungere una nuova voce usando il pulsante in alto.</div>
                    {% endif %}
                    <div class="settings-pagination mt-3">
                        <span class="small text-muted">{{ totale }} elementi · Pagina {{ pagina }} / {{ pagine }}</span>
                        <div class="d-flex gap-2">
                            <a class="btn btn-outline-secondary btn-sm {{ 'disabled' if pagina == 1 else '' }}" {% if pagina > 1 %}href="{{ url_for('ordini_cliente.impostazioni_pagina', sezione=spec.slug, q=q, pagina=pagina-1) }}"{% endif %}>← Precedente</a>
                            <a class="btn btn-outline-secondary btn-sm {{ 'disabled' if pagina == pagine else '' }}" {% if pagina < pagine %}href="{{ url_for('ordini_cliente.impostazioni_pagina', sezione=spec.slug, q=q, pagina=pagina+1) }}"{% endif %}>Successiva →</a>
                        </div>
                    </div>
                </div>
            </section>

            <section class="card settings-panel" id="modulo-configurazione">
                <div class="card-header settings-panel-header">
                    <h2 class="h5 mb-0">{{ 'Modifica' if record_modifica else 'Nuova configurazione' }}</h2>
                    {% if record_modifica %}
                        <a class="btn btn-sm btn-outline-secondary" href="{{ url_for('ordini_cliente.impostazioni_pagina', sezione=spec.slug) }}">Annulla modifica</a>
                    {% endif %}
                </div>
                <form method="post" action="{{ url_for('ordini_cliente.impostazioni_salva', sezione=spec.slug) }}">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
                    {% if token_modifica %}<input type="hidden" name="_record_token" value="{{ token_modifica }}">{% endif %}
                    <div class="card-body settings-form-grid">
                        {% for campo in spec.campi %}
                            <div class="settings-field">
                                <label class="form-label fw-semibold" for="conf-{{ campo.nome }}">{{ campo.etichetta }}{% if campo.obbligatorio %} <span class="text-danger">*</span>{% endif %}</label>
                                {% set valore = valori_form.get(campo.nome, '') %}
                                {% set blocca = record_modifica is not none and campo.nome in chiavi %}
                                {% if campo.tipo == 'fk' or campo.tipo == 'select' %}
                                    <select class="form-select" id="conf-{{ campo.nome }}" name="{{ campo.nome }}" {% if campo.obbligatorio %}required{% endif %} {% if blocca %}disabled{% endif %}>
                                        <option value="">— Seleziona —</option>
                                        {% set scelte = opzioni.get(campo.nome, []) if campo.tipo == 'fk' else campo.scelte %}
                                        {% for id_opzione, descrizione in scelte %}
                                            <option value="{{ id_opzione }}" {{ 'selected' if id_opzione|string == valore|string else '' }}>{{ descrizione }}</option>
                                        {% endfor %}
                                    </select>
                                    {% if spec.slug == 'articoli-ricette' and campo.nome == 'CodArt' and not scelte %}
                                        <div class="form-text text-warning">Non ci sono articoli ERP disponibili: risultano tutti già associati a una ricetta.</div>
                                    {% endif %}
                                {% elif campo.tipo == 'integer' %}
                                    <input class="form-control" id="conf-{{ campo.nome }}" type="number" name="{{ campo.nome }}" value="{{ valore }}"
                                           step="1" {% if campo.minimo is not none %}min="{{ campo.minimo }}"{% endif %}
                                           {% if campo.obbligatorio %}required{% endif %} {% if blocca %}readonly{% endif %}>
                                {% elif campo.tipo == 'decimal' %}
                                    <input class="form-control" id="conf-{{ campo.nome }}" type="text" inputmode="decimal" name="{{ campo.nome }}"
                                           value="{{ valore }}" placeholder="Es. 1,10" {% if campo.obbligatorio %}required{% endif %} {% if blocca %}readonly{% endif %}>
                                {% else %}
                                    <input class="form-control" id="conf-{{ campo.nome }}" type="text" name="{{ campo.nome }}" value="{{ valore }}"
                                           maxlength="{{ campo.lunghezza }}" {% if campo.obbligatorio %}required{% endif %} {% if blocca %}readonly{% endif %}>
                                {% endif %}
                                {% if campo.aiuto %}<div class="form-text">{{ campo.aiuto }}</div>{% endif %}
                                {% if blocca %}<div class="form-text">Identificativo non modificabile. Per cambiare il collegamento, creane uno nuovo e rimuovi quello precedente.</div>{% endif %}
                            </div>
                        {% endfor %}
                    </div>
                    <div class="card-footer settings-form-footer">
                        <span class="small text-muted">* Campi obbligatori</span>
                        <button class="btn btn-primary" type="submit">{{ 'Salva modifiche' if record_modifica else 'Crea configurazione' }}</button>
                    </div>
                </form>
            </section>
        </div>
    </div>
</div>
{% endblock %}
