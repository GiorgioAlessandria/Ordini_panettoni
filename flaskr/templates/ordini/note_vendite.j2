{% extends "base.j2" %}
{% block title %}<title>Commenti vendite ordine {{ ordine.IdDocumento }}-{{ ordine.IdRigaDoc }}</title>{% endblock %}
{% block content %}
<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div><h1 class="h4">Commenti ordine {{ ordine.IdDocumento }}-{{ ordine.IdRigaDoc }}</h1>
        <p class="text-secondary mb-0">{{ ordine.DesArt }} · {{ ordine.CodArt }}</p></div>
        <a href="{{ url_for('ordini_cliente.ordini_cliente') }}" class="btn btn-outline-secondary">Torna agli ordini</a>
    </div>
    {% if puo_scrivere_note_vendite %}
    <section class="card p-3 mb-3"><h2 class="h6">Nuovo commento delle vendite</h2>
        <form method="post" action="{{ url_for('ordini_cliente.aggiungi_nota_vendite', id_documento=ordine.IdDocumento, id_riga=ordine.IdRigaDoc) }}">
            <input type="hidden" name="csrf_token" value="{{ csrf_ruoli() }}">
            <textarea name="testo" class="form-control mb-2" maxlength="2000" required rows="3"></textarea>
            <button type="submit" class="btn btn-primary">Salva commento</button>
        </form>
    </section>
    {% else %}<p class="alert alert-info">I commenti delle vendite sono in sola lettura.</p>{% endif %}
    <h2 class="h5">Storico commenti</h2>
    {% for nota in note %}
        <article class="card p-3 mb-2"><div class="text-secondary small mb-2">{{ nota.AutoreNome }} · {{ nota.CreatoIl.strftime('%d/%m/%Y %H:%M') }}{% if nota.ModificatoIl %} · modificato{% endif %}</div>
        <p style="white-space:pre-wrap">{{ nota.Testo }}</p>
        {% if ruolo_corrente == 'admin' or (ruolo_corrente == 'utente_vendite' and nota.AutoreId == g.user.id) %}
          <details><summary>Modifica commento</summary>
            <form method="post" action="{{ url_for('ordini_cliente.modifica_nota_vendite', nota_id=nota.Id) }}" class="mt-2">
                <input type="hidden" name="csrf_token" value="{{ csrf_ruoli() }}">
                <textarea name="testo" class="form-control mb-2" maxlength="2000" required>{{ nota.Testo }}</textarea>
                <button class="btn btn-outline-primary btn-sm" type="submit">Salva modifica</button>
            </form>
          </details>
        {% endif %}
        </article>
    {% else %}<p class="text-secondary">Nessun commento presente.</p>{% endfor %}
</div>
{% endblock %}
