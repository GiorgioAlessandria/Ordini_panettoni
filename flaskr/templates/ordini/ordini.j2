{% extends "base.j2" %}

{% block title %}
    Ordini panettoni
{% endblock %}

{% block content %}


<div class="ordini-workspace pan-page pan-orders-page">
    <header class="ordini-header pan-page-header">
        <div>
            <h1>Gestione ordini panettoni</h1>
            <p class="descrizione">Disponibilità e lavorazioni sulla stessa pagina.</p>
        </div>
    </header>

    <div class="ordini-panel-switch" role="group" aria-label="Seleziona la tabella da visualizzare">
        <button type="button" class="btn btn-primary btn-sm" data-panel-switch="nuovi" aria-pressed="true">Da produrre</button>
        <button type="button" class="btn btn-outline-primary btn-sm" data-panel-switch="produzione" aria-pressed="false">In produzione</button>
    </div>

    <div class="ordini-panels">
        <section class="ordini-panel pan-panel" data-panel="nuovi" aria-labelledby="titolo-nuovi">
            <div class="ordini-panel-header pan-panel-header">
                <h2 id="titolo-nuovi">Ordini da produrre</h2>
                <span class="ordini-meta">Aggiornamento automatico ogni 30 secondi</span>
            </div>
            <div class="ordini-panel-body pan-panel-body">
                <div id="ordini_cliente_da_produrre"
                     hx-get="{{ url_for('ordini_cliente.tabella_ordini_cliente_da_produrre') }}"
                     hx-trigger="load, every 30s, pianificazioneSalvata from:body, prioritaAggiornata from:body, pianificazioneChiusa from:body, pianificazioneAnnullata from:body"
                     hx-swap="innerHTML"
                     hx-sync="this:replace"
                     aria-live="off">
                    <p class="ordini-loading">Caricamento ordini da produrre...</p>
                </div>
                {% if puo_gestire_produzione %}
                <div class="ordini-actions">
                    <button type="button" class="btn btn-primary"
                            hx-post="{{ url_for('ordini_cliente.anteprima_pianificazione') }}"
                            hx-include="#form-ordini"
                            hx-target="#contenuto-pianificazione"
                            hx-swap="innerHTML"
                            data-bs-toggle="modal"
                            data-bs-target="#modal-pianificazione">
                        Pianifica ordini selezionati
                    </button>
                    
                </div>
                {% endif %}
                {% if puo_gestire_produzione %}
                <div id="riepilogo-ordini" class="ordini-sommario mt-2" aria-live="polite">
                    Nessun ordine selezionato
                </div>
                {% endif %}
            </div>
        </section>

        <section class="ordini-panel pan-panel" data-panel="produzione" aria-labelledby="titolo-produzione">
            <div class="ordini-panel-header pan-panel-header">
                <h2 id="titolo-produzione">Ordini in produzione</h2>
                <span class="ordini-meta">Aggiornamento automatico ogni 30 secondi</span>
            </div>
            <div class="ordini-panel-body pan-panel-body">
                <div id="ordini_cliente_in_produzione"
                     hx-get="{{ url_for('ordini_cliente.tabella_ordini_cliente_in_produzione') }}"
                     hx-trigger="load, every 30s, pianificazioneSalvata from:body, prioritaAggiornata from:body, pianificazioneChiusa from:body, pianificazioneAnnullata from:body"
                     hx-swap="innerHTML"
                     hx-sync="this:replace"
                     aria-live="off">
                    <p class="ordini-loading">Caricamento ordini in produzione...</p>
                </div>
            </div>
        </section>
    </div>
</div>

{% if puo_gestire_produzione %}
<div class="modal fade" id="modal-pianificazione" tabindex="-1" aria-label="Pianificazione produzione">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content" id="contenuto-pianificazione"></div>
    </div>
</div>
{% endif %}
{% endblock %}

{% block scripts %}
    {{ super() }}
    <script src="{{ url_for('static', filename='js/selezione_ordini.js', v='20261020-2') }}"></script>
    <script src="{{ url_for('static', filename='js/responsive.js', v='20261020-2') }}" defer></script>
{% endblock %}
